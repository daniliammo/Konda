// §134: ЕДИНСТВЕННЫЙ список токенов Konda (X-macro). Из него генерируются
// перечисление ТипТокена (транспилятор.h), отладочные имена
// (имя_типа_токена), таблица ключевых слов лексера и таблица примитивных
// типов ПРИМИТИВЫ[] (§133). Новый токен — одна строка здесь.
//
// Подключающий файл определяет макросы и включает этот файл; в конце они
// снимаются (#undef), так что файл можно подключать многократно:
//   ТОКЕН(перечислитель, отладочное имя, ключевое слово или nullptr)
//   ПРИМИТИВ(перечислитель, отладочное имя, ключевое слово, C-тип,
//            C-тип с «неподписанный» или nullptr, размер в байтах на LP64)
// Если ПРИМИТИВ не определён, примитив раскрывается как обычный ТОКЕН.
// Порядок строк = порядок значений перечисления.
//
// Контекстные слова («и», «буфер», «строка», «внешняя», …) — НЕ ключевые:
// у их токена слово nullptr, распознаёт их разбор по месту.

#ifndef ПРИМИТИВ
#define ПРИМИТИВ(перечислитель, отладочное, слово, си, си_беззнаковый, размер) \
    ТОКЕН(перечислитель, отладочное, слово)
#endif

ТОКЕН(ТОКЕН_ИДЕНТИФИКАТОР,         "Идентификатор",         nullptr)
ТОКЕН(ТОКЕН_ЧИСЛО,                 "Число",                 nullptr)
ТОКЕН(ТОКЕН_СТРОКА,                "Строка",                nullptr)
ТОКЕН(ТОКЕН_СИМВОЛ,                "Символ",                nullptr)

// Операторы
ТОКЕН(ТОКЕН_НЕИЗВЕСТНЫЙ_ОПЕРАТОР,  "НеизвестныйОператор",   nullptr)
ТОКЕН(ТОКЕН_ЗВЕЗДА,                "*",                     nullptr)
ТОКЕН(ТОКЕН_КОСАЯ_ЧЕРТА,           "/",                     nullptr)
ТОКЕН(ТОКЕН_ПЛЮС,                  "+",                     nullptr)
ТОКЕН(ТОКЕН_МИНУС,                 "-",                     nullptr)
ТОКЕН(ТОКЕН_РАВНО,                 "=",                     nullptr)
ТОКЕН(ТОКЕН_АМПЕРСАНД,             "&",                     nullptr)
ТОКЕН(ТОКЕН_ПРОЦЕНТ,               "%",                     nullptr)
ТОКЕН(ТОКЕН_ПРЯМАЯ_ЧЕРТА,          "|",                     nullptr)
ТОКЕН(ТОКЕН_ВОСКЛИЦАТЕЛЬНЫЙ_ЗНАК,  "!",                     nullptr)
ТОКЕН(ТОКЕН_СТРЕЛКА_ВЛЕВО,         "<",                     nullptr)
ТОКЕН(ТОКЕН_СТРЕЛКА_ВПРАВО,        ">",                     nullptr)
ТОКЕН(ТОКЕН_СТРЕЛКА_ВВЕРХ,         "^",                     nullptr)
ТОКЕН(ТОКЕН_ТИЛЬДА,                "~",                     nullptr)
ТОКЕН(ТОКЕН_ИНКРЕМЕНТ,             "++",                    nullptr)
ТОКЕН(ТОКЕН_ДЕКРЕМЕНТ,             "--",                    nullptr)
// «+=» «-=» «*=» «/=» «%=» «&=» «|=» «^=» «<<=» «>>=»
ТОКЕН(ТОКЕН_СОСТАВНОЕ_ПРИСВАИВАНИЕ, "СоставноеПрисваивание", nullptr)

ТОКЕН(ТОКЕН_РАЗМЕР_ОБЬЕКТА,        "РазмерОбьекта",         "размер_обьекта")       // sizeof
ТОКЕН(ТОКЕН_ВЫРАВНИВАНИЕ_ОБЬЕКТА,  "ВыравниваниеОбьекта",   "выравнивание_обьекта") // alignof
ТОКЕН(ТОКЕН_ЕСЛИ,                  "Если",                  "если")        // if
ТОКЕН(ТОКЕН_ИНАЧЕ,                 "Иначе",                 "иначе")       // else
ТОКЕН(ТОКЕН_ИЛИ,                   "Или",                   "или")         // or
ТОКЕН(ТОКЕН_ПОКА,                  "Пока",                  "пока")        // while
ТОКЕН(ТОКЕН_ДЛЯ,                   "Для",                   "для")         // for
// параллельно для — параллелизм данных по непересекающимся кускам
ТОКЕН(ТОКЕН_ПАРАЛЛЕЛЬНО,           "Параллельно",           "параллельно")
// foreach: для_каждого (имя из коллекция) { ... }
ТОКЕН(ТОКЕН_ДЛЯ_КАЖДОГО,           "Для_каждого",           "для_каждого")
ТОКЕН(ТОКЕН_ИЗ,                    "Из",                    "из")          // разделитель в для_каждого
ТОКЕН(ТОКЕН_ВЕРНУТЬ,               "Вернуть",               "вернуть")     // return
ТОКЕН(ТОКЕН_ПРЕРВАТЬ,              "Прервать",              "прервать")    // break
ТОКЕН(ТОКЕН_ПРОДОЛЖИТЬ,            "Продолжить",            "продолжить")  // continue
ТОКЕН(ТОКЕН_ТОЧКА_ВХОДА,           "ТочкаВхода",            "точка_входа")
ТОКЕН(ТОКЕН_НУЛЬ,                  "Нуль",                  "нуль")        // nullptr
ТОКЕН(ТОКЕН_ИСТИНА,                "Истина",                "истина")      // true  (литерал типа логический)
ТОКЕН(ТОКЕН_ЛОЖЬ,                  "Ложь",                  "ложь")        // false (литерал типа логический)

// Примитивные типы (ключевые слова, не идентификаторы) — §133
ПРИМИТИВ(ТОКЕН_ЦЕЛОЕ8,         "Целое8",         "целое8",         "int8_t",  "uint8_t",  1)
ПРИМИТИВ(ТОКЕН_ЦЕЛОЕ16,        "Целое16",        "целое16",        "int16_t", "uint16_t", 2)
ПРИМИТИВ(ТОКЕН_ЦЕЛОЕ32,        "Целое32",        "целое32",        "int32_t", "uint32_t", 4)
ПРИМИТИВ(ТОКЕН_ЦЕЛОЕ64,        "Целое64",        "целое64",        "int64_t", "uint64_t", 8)
ПРИМИТИВ(ТОКЕН_БАЙТ,           "Байт",           "байт",           "uint8_t", nullptr,    1)
ПРИМИТИВ(ТОКЕН_ВЕЩЕСТВЕННОЕ,   "Вещественное",   "вещественное",   "float",   nullptr,    4)
ПРИМИТИВ(ТОКЕН_ВЕЩЕСТВЕННОЕ64, "Вещественное64", "вещественное64", "double",  nullptr,    8)
// char (тип, не литерал '...')
ПРИМИТИВ(ТОКЕН_ТИП_СИМВОЛ,     "ТипСимвол",      "символ",         "char",    nullptr,    1)
// bool (C23) — истина/ложь
ПРИМИТИВ(ТОКЕН_ЛОГИЧЕСКИЙ,     "Логический",     "логический",     "bool",    nullptr,    1)
// void — только как тип возврата функции (без значения)
ПРИМИТИВ(ТОКЕН_НИЧЕГО,         "Ничего",         "ничего",         "void",    nullptr,    0)

ТОКЕН(ТОКЕН_НЕПОДПИСАННЫЙ,         "Неподписанный",         "неподписанный") // unsigned
// срез<T> — толстый указатель {данные, длина}
ТОКЕН(ТОКЕН_СРЕЗ,                  "Срез",                  "срез")
// буфер<T> — растущий владеющий буфер {данные, длина, ёмкость} (как Rust
// Vec<T>): добавить/перевыделить; читается как срез<T>. Контекстное слово.
ТОКЕН(ТОКЕН_БУФЕР,                 "Буфер",                 nullptr)
// поток<T> — дескриптор потока, результат типа T
ТОКЕН(ТОКЕН_ПОТОК,                 "Поток",                 "поток")
// Ящик<T> — одиночный владеющий heap-объект (T*, autofree)
ТОКЕН(ТОКЕН_ЯЩИК,                  "Ящик",                  "Ящик")
// атом<T> — атомарный глобал (_Atomic T): shared-состояние без гонок данных
// (единственный изменяемый глобал)
ТОКЕН(ТОКЕН_АТОМ,                  "Атом",                  "атом")
// static — внутренняя связь / статическая длительность
ТОКЕН(ТОКЕН_СТАТИЧЕСКИЙ,           "Статический",           "статический")
// конст — иммутабельная переменная (нельзя переприсвоить)
ТОКЕН(ТОКЕН_КОНСТ,                 "Конст",                 "конст")
// выровнять(N) — C23 alignas(N): выравнивание объявления/поля
ТОКЕН(ТОКЕН_ВЫРОВНЯТЬ,             "Выровнять",             "выровнять")
// возможно<T*> — nullable-указатель (иначе указатель ненулевой)
ТОКЕН(ТОКЕН_ВОЗМОЖНО,              "Возможно",              "возможно")
// владеет — параметр забирает владение срезом (потребитель)
ТОКЕН(ТОКЕН_ВЛАДЕЕТ,               "Владеет",               "владеет")
// изменяемый — параметр по ссылке (C# ref): чтение+запись
ТОКЕН(ТОКЕН_ИЗМЕНЯЕМЫЙ,            "Изменяемый",            "изменяемый")
// вывод — выходной параметр по ссылке (C# out): обязан быть присвоен в теле
// до возврата
ТОКЕН(ТОКЕН_ВЫВОД,                 "Вывод",                 "вывод")
// структура — пользовательский составной тип
ТОКЕН(ТОКЕН_СТРУКТУРА,             "Структура",             "структура")
// союз — C union (поля разделяют память)
ТОКЕН(ТОКЕН_СОЮЗ,                  "Союз",                  "союз")
// пространство Имя { … } — пространство имён
ТОКЕН(ТОКЕН_ПРОСТРАНСТВО,          "Пространство",          "пространство")
// использовать Имя — импорт имён пространства
ТОКЕН(ТОКЕН_ИСПОЛЬЗОВАТЬ,          "Использовать",          "использовать")
// перечисление — пользовательский тип-перечисление (enum)
ТОКЕН(ТОКЕН_ПЕРЕЧИСЛЕНИЕ,          "Перечисление",          "перечисление")
// как<тип>(выр) — явное приведение типа (cast)
ТОКЕН(ТОКЕН_КАК,                   "Как",                   "как")
// выбор выр { ВАРИАНТ { … } } — match по перечислению
ТОКЕН(ТОКЕН_ВЫБОР,                 "Выбор",                 "выбор")
// небезопасно { … } — блок, где разрешены операции с сырыми указателями
// (арифметика/индексация), запрещённые в безопасном коде. Проверка
// статическая (без рантайма).
ТОКЕН(ТОКЕН_НЕБЕЗОПАСНО,           "Небезопасно",           "небезопасно")
// типфункции — объявление именованного типа-указателя на функцию
ТОКЕН(ТОКЕН_ТИПФУНКЦИИ,            "ТипФункции",            "типфункции")
// тип_данных-маркер: значение имеет тип «указатель на функцию» (имя_типа
// хранит имя типфункции-псевдонима)
ТОКЕН(ТОКЕН_ФУНКУКАЗАТЕЛЬ,         "ФункУказатель",         nullptr)
// тип_данных-маркер: параметр-тип «T» обобщённой функции (имя_типа хранит T);
// подставляется мономорфизацией
ТОКЕН(ТОКЕН_ТИПОПАРАМЕТР,          "ТипоПараметр",          nullptr)

// Пунктуация
ТОКЕН(ТОКЕН_КРУГЛАЯ_СКОБКА_ОТКРЫВАЕТСЯ,    "(", nullptr)
ТОКЕН(ТОКЕН_КРУГЛАЯ_СКОБКА_ЗАКРЫВАЕТСЯ,    ")", nullptr)
ТОКЕН(ТОКЕН_КВАДРАТНАЯ_СКОБКА_ОТКРЫВАЕТСЯ, "[", nullptr)
ТОКЕН(ТОКЕН_КВАДРАТНАЯ_СКОБКА_ЗАКРЫВАЕТСЯ, "]", nullptr)
ТОКЕН(ТОКЕН_ФИГУРНАЯ_СКОБКА_ОТКРЫВАЕТСЯ,   "{", nullptr)
ТОКЕН(ТОКЕН_ФИГУРНАЯ_СКОБКА_ЗАКРЫВАЕТСЯ,   "}", nullptr)
ТОКЕН(ТОКЕН_ТОЧКА,                         ".", nullptr)
ТОКЕН(ТОКЕН_ДИАПАЗОН,      "..",  nullptr)  // полу-открытый диапазон (§B2: для i в a..b)
ТОКЕН(ТОКЕН_ДИАПАЗОН_ВКЛ,  "..=", nullptr)  // включительный диапазон (для i в a..=b)
ТОКЕН(ТОКЕН_ЗАПЯТАЯ,       ",",   nullptr)
// одиночный «:» — граница среза-диапазона внутри «[…]» (§42: s[a:b]). Значим
// только там; «::»/«?:» — отдельные (двухсимвольные распознаются раньше).
ТОКЕН(ТОКЕН_ДВОЕТОЧИЕ,     ":",   nullptr)
ТОКЕН(ТОКЕН_ТОЧКА_С_ЗАПЯТОЙ, ";", nullptr)
ТОКЕН(ТОКЕН_РЕШЕТКА,       "#",   nullptr)

ТОКЕН(ТОКЕН_ПРЕПРОЦЕССОР,  "Препроцессор", nullptr)
ТОКЕН(ТОКЕН_КОММЕНТАРИЙ,   "Комментарий",  nullptr)
ТОКЕН(ТОКЕН_НОВАЯ_СТРОКА,  "НоваяСтрока",  nullptr)
ТОКЕН(ТОКЕН_КОНЕЦ_ФАЙЛА,   "КонецФайла",   nullptr)
ТОКЕН(ТОКЕН_НЕИЗВЕСТНЫЙ,   "НЕИЗВЕСТНЫЙ_ТОКЕН", nullptr)

#undef ТОКЕН
#undef ПРИМИТИВ
