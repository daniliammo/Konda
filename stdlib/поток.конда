// поток.конда — буферизованный вывод (модуль stdlib «поток», §83/C4).
//
// ЗАЧЕМ. Модуль «файл» делает syscall на КАЖДЫЙ записать(): цикл из N мелких
// записей = N syscall'ов. glibc stdio (fwrite) копит их в буфер и сбрасывает
// ОДНИМ write — на мелко-гранулярном выводе это в десятки–сотни раз быстрее.
// Это был главный оставшийся разрыв stdlib Konda с glibc (см. bench/README.md).
// БуферВывода закрывает его: копит символы в хранилище фиксированной ёмкости,
// сбрасывает одним конда_ио_записать при заполнении и при выходе из области
// (RAII через [удалить]).
//
// Стал возможен после §83 — экспорта структуры с владеющим полем-срез через «.и».
//
// СОЗДАНИЕ. Структуру с деструктором язык не возвращает по значению (и литерал
// строится только в объявлении), поэтому буфер создаётся ЛИТЕРАЛОМ на месте:
//
//   БуферВывода б = { фд = 1, хранилище = выделить(8192), заполнено = 0 }
//   записать_текст(б, "привет\n")
//   // сброс автоматически при выходе из области (RAII)
//
// фд — открытый дескриптор (1 — stdout, или Файл.фд из открыть_запись).
// хранилище — выделить(N), N ≥ 1 (типично 8192, как BUFSIZ stdio): порог сброса
// = длина(хранилище), поэтому N — единственный источник правды, переполнения нет.
// заполнено — всегда 0.
//
// БЕЗОПАСНОСТЬ. Зона «доверия» — тот же C-шим конда_ио.h (§32), вызов гейтится
// «небезопасно». Хранилище — владеющий срез<символ> (autofree после деструктора,
// порядок проверен: [удалить] зовётся ПЕРЕД free поля). Границы держит индексатор
// среза. Дескриптор фд НЕ закрывается буфером (владелец — Файл/вызывающий): буфер
// лишь флашит, двойного close нет. Пользователь БуферВывода работает без «небезопасно».

#содержит "конда_ио.h"

внешняя целое64 конда_ио_записать(целое32 фд, срез<символ> буфер)

[удалить = _поток_сбросить] структура БуферВывода {
    целое32 фд
    срез<символ> хранилище
    целое32 заполнено
}

// Сбросить накопленное одним системным вызовом (если есть что писать).
ничего сбросить(изменяемый БуферВывода б) {
    если б.заполнено > 0 {
        небезопасно {
            конда_ио_записать(б.фд, б.хранилище[0:б.заполнено])
        }
        б.заполнено = 0
    }
}

// Записать один символ (в буфер; сброс — при заполнении).
ничего записать_байт(изменяемый БуферВывода б, символ с) {
    если б.заполнено >= как<целое32>(длина(б.хранилище)) {
        сбросить(б)
    }
    б.хранилище[б.заполнено] = с
    б.заполнено = б.заполнено + 1
}

// Записать текст (срез символов) — побайтово через буфер.
ничего записать_текст(изменяемый БуферВывода б, срез<символ> текст) {
    для целое32 и = 0; и < длина(текст); и = и + 1 {
        записать_байт(б, текст[и])
    }
}

// Деструктор [удалить]: сбросить остаток на выходе из области. Фд не закрываем
// (владелец — вызывающий). Хранилище освобождается кодогеном после этого вызова.
ничего _поток_сбросить(изменяемый БуферВывода б) {
    сбросить(б)
}
