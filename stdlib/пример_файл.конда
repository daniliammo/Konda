// Пример пользователя stdlib/файл — БЕЗ единого «небезопасно» и без сырых
// указателей, с единым sum-типом Результат<T,E> для ошибок (§33).
// Программа:
//   1) открывает /proc/self/cmdline на чтение,
//   2) читает до 256 байт в срез (границы гарантированы длиной среза),
//   3) печатает содержимое,
//   4) закрывает файл автоматически при выходе из ветки выбора (RAII).
//
// Сборка (из корня проекта):
//   ./Собранное/ТранспиляторКонда stdlib/файл.конда stdlib/пример_файл.конда \
//       --вывод=stdlib/вывод
//   stdlib/вывод/файл.elf

#содержит <stdio.h>

целое32 точка_входа(целое32 количество_аргументов, символ** аргументы)
{
    выбор открыть_чтение("/proc/self/cmdline") {
        Успех(фд64) {
            // С этой точки — RAII: `ф` авто-закроется на выходе из ветки.
            Файл ф = { фд = как<целое32>(фд64) }

            срез<символ> буфер = выделить(256)

            выбор прочитать(ф, буфер) {
                Успех(н) {
                    целое32 всего = как<целое32>(н)
                    printf("прочитано %d байт: ", всего)
                    // Печать посимвольно: /proc/self/cmdline разделён '\0'.
                    для (целое32 к = 0; к < всего; к = к + 1) {
                        символ с = буфер[к]
                        если (с == как<символ>(0)) {
                            printf(" ")
                        } иначе {
                            printf("%c", с)
                        }
                    }
                    printf("\n")
                }
                Провал(код) {
                    printf("ошибка чтения: %d\n", код)
                }
            }
        }
        Провал(код) {
            printf("не удалось открыть: %d\n", код)
            вернуть 1
        }
    }
    вернуть 0
}
