// ─────────────────────────────────────────────────────────────────────────────
// stdlib/путь.конда — операции над файловыми путями `срез<символ>` (Konda L2).
//
// Чистый Konda поверх встроенных срезов: ни одного сырого указателя, ни одного
// системного вызова (это НЕ работа с ФС, а разбор строки-пути). Разделитель —
// POSIX «/» (целевая ОС «Чёрное Море» и Linux-хост).
//
// Функции возвращают ВЛАДЕЮЩУЮ копию (`клон`) под-пути, а не заимствованный вид:
// язык запрещает возвращать `имя[a:b]` напрямую (висячий вид), поэтому отдаём
// самостоятельную строку — вызывающему не нужно держать исходный путь живым.
// Пути короткие, стоимость копии пренебрежима.
// ─────────────────────────────────────────────────────────────────────────────

// Базовое имя: часть пути после последнего «/» («src/окно.конда» → «окно.конда»,
// «окно» → «окно», «a/b/» → «»). Без слэшей — весь путь.
срез<символ> базовое_имя(срез<символ> путь)
{
    целое32 n = как<целое32>(длина(путь))
    целое32 начало = 0
    для i в 0..n {
        если путь[i] == '/' { начало = i + 1 }
    }
    строка имя = клон(путь[начало : n])
    вернуть имя
}

// Каталог пути: часть до последнего «/» без самого слэша («src/окно.конда» →
// «src», «a/b/c» → «a/b», без слэша → «»). Полезно как пара к `базовое_имя`.
срез<символ> каталог(срез<символ> путь)
{
    целое32 n = как<целое32>(длина(путь))
    целое32 конец = 0
    логический есть_слэш = ложь
    для i в 0..n {
        если путь[i] == '/' { конец = i; есть_слэш = истина }
    }
    если есть_слэш == ложь { конец = 0 }
    строка кат = клон(путь[0 : конец])
    вернуть кат
}

// Без расширения: часть имени до ПОСЛЕДНЕЙ точки в базовом имени
// («окно.конда» → «окно», «архив.tar.gz» → «архив.tar», «имя» → «имя»,
// «.скрытый» → «.скрытый» — ведущая точка не считается расширением).
срез<символ> без_расширения(срез<символ> имя)
{
    целое32 n = как<целое32>(длина(имя))
    целое32 точка = n
    для i в 0..n {
        если имя[i] == '.' и i > 0 { точка = i }
    }
    строка база = клон(имя[0 : точка])
    вернуть база
}

// Основа пути = базовое имя без расширения («src/окно.конда» → «окно»). Частый
// случай: имя цели/модуля из пути к исходнику.
срез<символ> основа(срез<символ> путь)
{
    вернуть без_расширения(базовое_имя(путь))
}
