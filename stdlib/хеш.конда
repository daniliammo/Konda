// ─────────────────────────────────────────────────────────────────────────────
// stdlib/хеш.конда — хеш-функции (Konda-слой L2 над C-шимом конда_хеш.h L1).
//
// FNV-1a 64-бит по байтам строки/среза: детерминированный, быстрый — для хеш-
// таблиц и ключей актуальности. Сама арифметика (беззнаковый перенос, offset-
// basis > int64 max) не выражается в Konda → она в C-шиме; здесь — безопасная
// типизированная обёртка (срез с гарантированными границами по длине).
// ─────────────────────────────────────────────────────────────────────────────

#содержит "конда_хеш.h"

внешняя неподписанный целое64 конда_фнв1а(срез<символ> данные)

// FNV-1a 64-бит по байтам среза. `срез<символ>` несёт длину → шим не выйдет за
// границы по построению.
неподписанный целое64 фнв1а(срез<символ> данные)
{
    неподписанный целое64 хеш = 0
    небезопасно {
        хеш = конда_фнв1а(данные)
    }
    вернуть хеш
}
