// ─────────────────────────────────────────────────────────────────────────────
// stdlib/хеш.конда — хеш-функции, ПОЛНОСТЬЮ на Konda (без C-шима).
//
// FNV-1a 64-бит по байтам среза: детерминированный, быстрый — для хеш-таблиц и
// ключей актуальности. Раньше арифметика жила в C-шиме (конда_хеш.h), т.к.
// казалась невыразимой в Konda. Теперь выразима штатными средствами языка:
//   • offset-basis 14695981039346656037 (> int64 max) и FNV-prime задаются
//     hex-литералами (§66) — они уходят в C как есть, становятся unsigned long
//     long, без -Werror на суффикс;
//   • переполнение при `неподписанный целое64` умножении/сложении — определённый
//     wrap в C, guard-abort §43 навешивается ТОЛЬКО на ЗНАКОВЫЕ типы → тут его
//     нет, арифметика идёт нативно;
//   • байт из `символ` берётся явным кастом `как<неподписанный целое64>` (§75,
//     без гейта `небезопасно`), а маска `& 0xFF` гасит знак-расширение signed
//     char для байтов ≥ 0x80 (проверено на UTF-8-строках против эталона C).
// `срез<символ>` несёт длину → выход за границы .данные исключён по построению.
// ─────────────────────────────────────────────────────────────────────────────

// FNV-1a 64-бит с ПРОДОЛЖЕНИЕМ (seedable): позволяет хешировать поток по кускам,
// докидывая новые данные к уже накопленному ключу. Конвенция: seed == 0 → начать
// с offset basis (свежий хеш), иначе продолжить с seed. Возврат — целое64
// (реинтерпретация беззнакового), чтобы ключ можно было цепить через границы
// типов (напр. чередуя со срезами и argv).
//
// ⚠ ЕДИНЫЙ ИСТОЧНИК FNV для всей экосистемы. C-шим системы сборки
// (`сборка/сборка_шим.h`) НЕ держит свою копию арифметики: его I/O-хешеры
// (файл/включения/транспилятор) читают байты и делегируют счёт ВОТ СЮДА через
// forward-декларацию `int64_t фнв1а_с(Срез, int64_t)`. Поэтому ключ хеш-кэша
// цепляется бесшовно между Konda-путями (срез/argv) и C-путями (файлы). Менять
// константы/конвенцию seed нельзя, не синхронизировав обе стороны.
целое64 фнв1а_с(срез<символ> данные, целое64 seed)
{
    неподписанный целое64 хеш = 0xcbf29ce484222325   // FNV offset basis
    если seed != 0 { хеш = как<неподписанный целое64>(seed) }
    для i в 0..длина(данные) {
        хеш = хеш ^ (как<неподписанный целое64>(данные[i]) & 0xFF)
        хеш = хеш * 0x100000001b3                     // FNV prime
    }
    вернуть как<целое64>(хеш)
}

// FNV-1a 64-бит по байтам среза. Возвращает 64-битный беззнаковый хеш.
неподписанный целое64 фнв1а(срез<символ> данные)
{
    вернуть как<неподписанный целое64>(фнв1а_с(данные, 0))
}

// FNV-1a по массиву C-строк (argv): каждый элемент хешируется байт-за-байтом до
// NUL, затем добавляется байт-разделитель 0x1F — чтобы ["-a","bc"] и ["-ab","c"]
// давали РАЗНЫЕ ключи. Продолжает seed по той же конвенции (0 → basis). Чтение
// сырого `символ*` — под гейтом `небезопасно` (инвариант №2); строки argv
// NUL-терминированы ядром по построению, выхода за границы нет.
целое64 фнв1а_аргв_с(срез<символ*> аргв, целое64 seed)
{
    неподписанный целое64 хеш = 0xcbf29ce484222325
    если seed != 0 { хеш = как<неподписанный целое64>(seed) }
    для i в 0..длина(аргв) {
        символ* с = аргв[i]
        небезопасно {
            целое32 j = 0
            пока с[j] != '\0' {
                хеш = хеш ^ (как<неподписанный целое64>(с[j]) & 0xFF)
                хеш = хеш * 0x100000001b3
                j = j + 1
            }
        }
        хеш = хеш ^ 0x1F                              // разделитель аргументов
        хеш = хеш * 0x100000001b3
    }
    вернуть как<целое64>(хеш)
}
