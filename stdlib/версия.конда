// ─────────────────────────────────────────────────────────────────────────────
// stdlib/версия.конда — semver-версия как СТРУКТУРА и её функции (§103).
//
// Типизированное представление версии «X.Y.Z»: три поля «неподписанный целое8»
// (мажор.минор.патч). Создаётся ИЗ СТРОКИ функцией «версия_из_строки»; сравнение —
// «версия_равна»/«версия_меньше» (порядок semver: сперва мажор, потом минор, потом
// патч). То же представление есть в транспиляторе (C-структура «КондаВерсия») и во
// фронтенде «konda build» (структура «Версия»): фронтенд САМ собирает stdlib
// (бутстрап-цикл) и потому держит собственную копию, а не потребляет этот модуль.
// Любая ОБЫЧНАЯ Konda-программа получает «Версия» и её функции авто-подключением
// stdlib (§35). 0 рантайма сверх самого разбора/сравнения.
// ─────────────────────────────────────────────────────────────────────────────

структура Версия { неподписанный целое8 мажор; неподписанный целое8 минор; неподписанный целое8 патч }

// Разобрать «X.Y.Z» в структуру: цифры копятся в текущее поле, точка/иной символ
// его завершают; каждое поле насыщается в диапазоне 0..255. Битый ввод → нули.
// «срез<символ>» несёт длину → выход за границы .данные исключён по построению.
Версия версия_из_строки(срез<символ> текст)
{
    неподписанный целое8 части[3] = { 0, 0, 0 }
    целое32 номер = 0
    целое32 текущее = 0
    для i в 0..длина(текст) {
        символ с = текст[i]
        если с >= '0' и с <= '9' {
            текущее = текущее * 10 + (код(с) - код('0'))
            если текущее > 255 { текущее = 255 }
        } иначе если номер < 3 {
            части[номер] = как<неподписанный целое8>(текущее)
            номер = номер + 1
            текущее = 0
        }
    }
    если номер < 3 {
        части[номер] = как<неподписанный целое8>(текущее)
    }
    Версия версия = { мажор = части[0], минор = части[1], патч = части[2] }
    вернуть версия
}

// Равны ли версии (совпадают все три поля).
логический версия_равна(Версия а, Версия б)
{
    вернуть а.мажор == б.мажор и а.минор == б.минор и а.патч == б.патч
}

// Строгий порядок semver: а < б? Сравниваем мажор, затем минор, затем патч.
логический версия_меньше(Версия а, Версия б)
{
    если а.мажор != б.мажор { вернуть а.мажор < б.мажор }
    если а.минор != б.минор { вернуть а.минор < б.минор }
    вернуть а.патч < б.патч
}
