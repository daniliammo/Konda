// ─────────────────────────────────────────────────────────────────────────────
// stdlib/файл.конда — БЕЗОПАСНЫЙ API работы с файлами (Konda-слой L2).
//
// Пользователь работает ТОЛЬКО с этими типами и функциями. Внутри — тонкие
// вызовы `конда_ио_*` из stdlib/конда_ио.h (L1, единственная зона
// «небезопасно»). Гарантии, которые язык обеспечивает даже здесь:
//   • RAII: тип `Файл` несёт [удалить=…] → автоматический close при выходе
//     из области жизни, даже при раннем вернуть/в ветке выбора;
//   • границы: `прочитать`/`записать` принимают `срез<символ>` — read/write
//     не выйдут за длину среза ПО ПОСТРОЕНИЮ (в шим передаётся длина);
//   • ошибки — единый обобщённый sum-тип `Результат<T, Ошибка>` (§33):
//     компилятор ЗАСТАВЛЯЕТ обработать оба случая (неисчерпывающий выбор
//     не соберётся); нет errno-глобала в пользовательском коде.
//
// Единый T=целое64 для всех операций (fd и число байт), E=целое32 (errno) —
// одна специализация `Результат<целое64, целое32>` на всю программу. Так v1
// обобщённых sum-типов держит инвариант «одна специализация на шаблон» цел.
// ─────────────────────────────────────────────────────────────────────────────

#содержит "конда_ио.h"

// L1: сырые обёртки над syscalls. Возврат — `целое64`, где ≥0 успех, <0 = -errno.
// Три отдельные open-функции (по режиму) вместо одной с флагами — так POSIX-
// флаги вообще не пересекают границу Konda (пользователю не нужен <fcntl.h>).
внешняя целое64 конда_ио_открыть_чтение(символ* путь)
внешняя целое64 конда_ио_открыть_запись(символ* путь, целое32 режим)
внешняя целое64 конда_ио_открыть_добавление(символ* путь, целое32 режим)
внешняя целое64 конда_ио_прочитать(целое32 фд, срез<символ> буфер)
внешняя целое64 конда_ио_записать(целое32 фд, срез<символ> буфер)
внешняя целое64 конда_ио_закрыть(целое32 фд)
внешняя целое64 конда_ио_размер(целое32 фд)

// ─── RAII-хендл ─────────────────────────────────────────────────────────────
// Файл с [удалить = _файл_закрыть]: при выходе из области жизни (нормальном
// возврате, раннем вернуть, ветке выбора) вызывается close. Двойного close
// быть не может — деструктор зовётся один раз (RAII); в шиме дополнительная
// страховка на fd<0.
[удалить = _файл_закрыть]
структура Файл {
    целое32 фд
}

целое32 _файл_закрыть(Файл* ф)
{
    небезопасно {
        целое64 _ = конда_ио_закрыть(ф.фд)
    }
    вернуть 0
}

// ─── Единый sum-тип результата ──────────────────────────────────────────────
// Обобщённый Результат<T, E> — фундамент всех fallible-операций (§33). В v1
// обобщённых sum-типов поддержана ОДНА специализация на шаблон в программе,
// поэтому все операции модуля возвращают Результат<целое64, целое32>:
//   • T = целое64: fd (для открытия) ИЛИ число прочитанных/записанных байт;
//   • E = целое32: POSIX errno (положительный).
// Пользователь пишет:  выбор открыть_чтение(путь) { Успех(фд) {...} Провал(код) {...} }
перечисление Результат<T, E> {
    Успех(T значение)
    Провал(E код)
}

// ─── Публичные обёртки ──────────────────────────────────────────────────────
// Открыть на чтение. Путь — NUL-терминированная строка (Konda «символ*»).
// Возврат — sum-тип: компилятор ЗАСТАВИТ обработать оба случая (иначе выбор
// неисчерпывающий → ошибка компиляции).
Результат<целое64, целое32> открыть_чтение(символ* путь)
{
    небезопасно {
        целое64 фд = конда_ио_открыть_чтение(путь)
        если (фд < 0) {
            вернуть Провал(как<целое32>(-фд))
        }
        вернуть Успех(фд)
    }
    вернуть Провал(0)  // недостижимо — но нужно для definite-return
}

// Открыть на запись (создать/обрезать). Режим = права POSIX (напр. 0644).
Результат<целое64, целое32> открыть_запись(символ* путь, целое32 режим)
{
    небезопасно {
        целое64 фд = конда_ио_открыть_запись(путь, режим)
        если (фд < 0) {
            вернуть Провал(как<целое32>(-фд))
        }
        вернуть Успех(фд)
    }
    вернуть Провал(0)
}

// Открыть на дописывание (создать, писать в конец).
Результат<целое64, целое32> открыть_добавление(символ* путь, целое32 режим)
{
    небезопасно {
        целое64 фд = конда_ио_открыть_добавление(путь, режим)
        если (фд < 0) {
            вернуть Провал(как<целое32>(-фд))
        }
        вернуть Успех(фд)
    }
    вернуть Провал(0)
}

// Прочитать в буфер. Границы гарантированы: read ограничен длиной среза.
// `изменяемый Файл` — операция ЛОГИЧЕСКИ меняет позицию в файле (даже если fd
// — int). Буфер передаётся как обычный `срез<символ>`: срез уже несёт длину
// (границы), а `изменяемый` к срезу неприменим — у него своя семантика владения.
Результат<целое64, целое32> прочитать(изменяемый Файл ф, срез<символ> буфер)
{
    небезопасно {
        целое64 н = конда_ио_прочитать(ф.фд, буфер)
        если (н < 0) {
            вернуть Провал(как<целое32>(-н))
        }
        вернуть Успех(н)
    }
    вернуть Провал(0)
}

// Записать буфер. Может вернуть меньше длины (частичная запись — обычный
// POSIX-случай; вызывающий крутит цикл, если это важно).
Результат<целое64, целое32> записать(изменяемый Файл ф, срез<символ> буфер)
{
    небезопасно {
        целое64 н = конда_ио_записать(ф.фд, буфер)
        если (н < 0) {
            вернуть Провал(как<целое32>(-н))
        }
        вернуть Успех(н)
    }
    вернуть Провал(0)
}

// Размер файла в байтах (fstat, не двигает позицию чтения).
Результат<целое64, целое32> размер(изменяемый Файл ф)
{
    небезопасно {
        целое64 р = конда_ио_размер(ф.фд)
        если (р < 0) {
            вернуть Провал(как<целое32>(-р))
        }
        вернуть Успех(р)
    }
    вернуть Провал(0)
}
