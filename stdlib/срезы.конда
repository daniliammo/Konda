// ─────────────────────────────────────────────────────────────────────────────
// stdlib/срезы.конда — ОБОБЩЁННЫЕ операции над `срез<T>` и `буфер<T>` (Konda L2).
//
// Сами типы `срез<T>`/`буфер<T>`, индексация с проверкой границ, выделение и рост
// буфера — ВСТРОЕННЫЕ примитивы языка (их порождает кодоген транспилятора, они
// доступны даже с `--без-стандартной-библиотеки`). Здесь — АЛГОРИТМЫ поверх этих
// примитивов, написанные на самом Konda: разворот, заполнение, обмен, копирование,
// дописывание. Всё обобщённо по `T` (мономорфизация §17/§18), header-only экспорт
// шаблонов (§101) и авто-внедрение у потребителя без `#содержит` (§110).
//
// Границы инварианта №1 сохранены: любой доступ `с[i]` проходит через встроенный
// `срез_доступ` (одно сравнение), выход за границы → детерминированный abort. Ни
// одна операция не берёт сырой указатель и не обходит проверки.
//
// Почему без `изменяемый` у среза: срез — это ВИД на чужую память (толстый
// указатель {данные, длина}); его элементы мутабельны через сам вид, поэтому
// `изменяемый срез<T>` избыточен (и запрещён — у среза своя семантика владения).
// Буфер же ВЛАДЕЕТ кучей и растёт (realloc может переместить) → рост буфера
// вызывающего идёт через `изменяемый буфер<T>` (ref-параметр).
//
// Ограничение по `T`: операции копируют элементы побайтово (присваивание/`добавить`),
// поэтому `T` — POD (без владеющих полей). Срез/буфер структур с владеющими полями
// язык и так запрещает (§22), так что это не новое ограничение, а следствие.
// ─────────────────────────────────────────────────────────────────────────────

// Развернуть срез НА МЕСТЕ: меняем местами симметричные пары от краёв к центру.
// Пустой/одноэлементный срез — no-op (цикл не выполняется). O(n/2) обменов.
ничего развернуть<T>(срез<T> с)
{
    целое32 n = как<целое32>(длина(с))
    для i в 0..(n / 2) {
        T временное = с[i]
        с[i] = с[n - 1 - i]
        с[n - 1 - i] = временное
    }
}

// Заполнить ВЕСЬ срез одним значением (как memset поэлементно, но типобезопасно
// и для любого `T`). Каждый элемент получает КОПИЮ значения.
ничего заполнить<T>(срез<T> с, T значение)
{
    для i в 0..длина(с) {
        с[i] = значение
    }
}

// Обменять местами два элемента среза. Индексы проверяются встроенным
// `срез_доступ` (обе индексации `с[i]`/`с[j]`) — выход за границы → abort.
ничего поменять_местами<T>(срез<T> с, целое32 i, целое32 j)
{
    T временное = с[i]
    с[i] = с[j]
    с[j] = временное
}

// Скопировать элементы из `откуда` в `куда`, но не больше, чем помещается:
// копируется min(длина(куда), длина(откуда)) элементов. Возвращает число
// скопированных элементов. Срезы могут быть разной длины; лишнее игнорируется.
целое64 скопировать<T>(срез<T> куда, срез<T> откуда)
{
    целое64 n = как<целое64>(длина(куда))
    целое64 m = как<целое64>(длина(откуда))
    целое64 сколько = n
    если m < сколько { сколько = m }
    для i в 0..сколько {
        куда[i] = откуда[i]
    }
    вернуть сколько
}

// Дописать все элементы среза `хвост` в конец буфера `б` (как Vec::extend).
// Каждый `добавить` может нарастить буфер амортизированным удвоением; при росте
// realloc может переместить память — заимствованные виды на буфер язык запрещает
// статически, поэтому висячих указателей нет.
ничего расширить<T>(изменяемый буфер<T> б, срез<T> хвост)
{
    для i в 0..длина(хвост) {
        добавить(б, хвост[i])
    }
}
