// ─────────────────────────────────────────────────────────────────────────────
// stdlib/строки.конда — базовые операции над строками `срез<символ>` (Konda L2).
//
// Сравнение — через ВСТРОЕННЫЙ оператор «==» над срезами (§100): поэлементное
// равенство, как Rust PartialEq для [T]. C-шима больше НЕТ (раньше равно/
// начинается_с роутились в glibc memcmp — §81; удалено по решению пользователя:
// сравнение — родной оператор языка, а не внешняя зависимость). Разбор
// (это_число/в_целое) — чистый Konda через встроенный `код()` (§75, код-поинт
// без `небезопасно`): там посимвольная логика.
//
// Разбор возвращает СВОЙ маленький struct `РазборЦелого`, а НЕ общий `Результат`
// из модуля `файл`: у многомодульной stdlib общий sum-тип дал бы дублирующийся
// C-typedef при подключении двух модулей сразу (и упор в «одна специализация на
// шаблон», §33 v1). Простой POD-результат этого избегает.
// ─────────────────────────────────────────────────────────────────────────────

// Результат разбора целого: значение + признак успеха (пустая строка, знак без
// цифр, нецифровой символ → ок=ложь, значение=0).
структура РазборЦелого {
    целое64 значение
    логический ок
}

// Равенство двух строк — родной оператор «==» над срезами (§100): равны, если
// равны длины И совпадают все элементы. Ноль внешних зависимостей.
логический равно(срез<символ> а, срез<символ> б)
{
    вернуть а == б
}

// Заканчивается ли `текст` на `суффикс`. Симметрично `начинается_с`: посимвольное
// сравнение последних `длина(суффикс)` байт (границы гарантирует проверка длины).
// Пустой суффикс → истина; суффикс длиннее текста → ложь.
логический заканчивается_на(срез<символ> текст, срез<символ> суффикс)
{
    целое32 лс = как<целое32>(длина(суффикс))
    целое32 лт = как<целое32>(длина(текст))
    если лс > лт { вернуть ложь }
    целое32 смещение = лт - лс
    для i в 0..лс {
        если текст[смещение + i] != суффикс[i] { вернуть ложь }
    }
    вернуть истина
}

// Первое десятичное число из строки: ведущие нецифровые байты пропускаются, затем
// читается серия цифр («-j8» → 8, «--задания=4» → 4, «8» → 8, без цифр → 0). В
// отличие от `в_целое` (строгий разбор со знаком) — извлекатель для смешанных
// токенов вида «префикс+число». Знак НЕ трактуется (минус — просто нецифровой
// пропускаемый байт), результат неотрицателен.
целое64 первое_число(срез<символ> текст)
{
    целое32 n = как<целое32>(длина(текст))
    целое32 i = 0
    пока i < n и (текст[i] < '0' или текст[i] > '9') { i = i + 1 }
    целое64 акк = 0
    пока i < n и текст[i] >= '0' и текст[i] <= '9' {
        акк = акк * 10 + как<целое64>(код(текст[i]) - код('0'))
        i = i + 1
    }
    вернуть акк
}

// Начинается ли `текст` с `префикс`. Посимвольное сравнение первых `длина(префикс)`
// элементов (границы гарантирует проверка длины). Осознанно НЕ через срез-диапазон
// `текст[:лп] == префикс`: под-вид `срез<символ>` требует попадания края на границу
// UTF-8-символа (§42) и на «непрефиксном» вводе прервал бы программу, а здесь мы
// хотим просто вернуть «ложь».
логический начинается_с(срез<символ> текст, срез<символ> префикс)
{
    целое32 лп = как<целое32>(длина(префикс))
    если лп > как<целое32>(длина(текст)) { вернуть ложь }
    для i в 0..лп {
        если текст[i] != префикс[i] { вернуть ложь }
    }
    вернуть истина
}

// Непустая строка, состоящая только из десятичных цифр.
логический это_число(срез<символ> текст)
{
    целое32 n = как<целое32>(длина(текст))
    если n == 0 { вернуть ложь }
    для i в 0..n {
        символ ц = текст[i]
        если ц < '0' или ц > '9' { вернуть ложь }
    }
    вернуть истина
}

// Разобрать десятичное целое (опциональный ведущий знак «-»/«+»). Нецифровой
// символ, пустая строка или «только знак» → ок=ложь. Переполнение целое64 на
// гигантском вводе в отладке аккуратно падает по guard (§43) — memory-safe;
// диапазон целое64 покрывает любой практический разбор.
РазборЦелого в_целое(срез<символ> текст)
{
    целое32 n = как<целое32>(длина(текст))
    РазборЦелого итог = { значение = 0, ок = ложь }
    если n == 0 { вернуть итог }
    целое32 i = 0
    логический отрицательное = ложь
    если текст[0] == '-' { отрицательное = истина; i = 1 }
    иначе если текст[0] == '+' { i = 1 }
    если i >= n { вернуть итог }              // только знак — не число
    целое64 акк = 0
    пока i < n {
        символ ц = текст[i]
        если ц < '0' или ц > '9' { вернуть итог }   // нецифровой → провал
        целое32 цифра = код(ц) - код('0')
        акк = акк * 10 + как<целое64>(цифра)
        i = i + 1
    }
    если отрицательное { акк = 0 - акк }
    итог.значение = акк
    итог.ок = истина
    вернуть итог
}
