// konda build — фронтенд системы сборки Konda (вариант B: отдельный Konda-бинарь).
// Читает манифест Konda.toml, разбирает его через libkonda_toml (через .и),
// собирает командную строку транспилятора и запускает его. Хеш-кэш защищает от
// устаревания (см. docs/СИСТЕМА_СБОРКИ.md). Кросс-платформенность — массив
// «цели» в [сборка]: по одной сборке на триплет, каждая в вывод/<триплет>.
//
// Имена — БЕЗ сокращений (правило проекта). Прикладная семантика манифеста
// (синонимы булевых да/нет, знание ключей) живёт ЗДЕСЬ, а не в TOML-библиотеке.

#содержит <stdio.h>
#содержит "../toml/вывод/toml.h"   // подтягивает toml.и (Диапазон, томл_*) + линкует toml.so
#содержит "сборка_шим.h"

внешняя целое32 сборка_прочитать_файл(символ* путь, срез<символ> буфер)
внешняя целое32 сборка_запустить(срез<символ*> аргв)
внешняя символ* сборка_склеить(срез<символ> префикс, срез<символ> хвост)
// FNV-хеширование срезов и argv — из stdlib/хеш.конда (вкомпилена во фронтенд):
// фнв1а_с(срез, seed), фнв1а_аргв_с(срез<символ*>, seed). I/O-хешеры остаются
// в C-шиме, но делегируют счёт в тот же фнв1а_с (единый источник FNV).
внешняя целое64 сборка_хеш_файла_с(символ* путь, целое64 seed)
внешняя целое64 сборка_хеш_транспилятора_с(целое64 seed)
внешняя целое64 сборка_читать_кэш(символ* путь)
внешняя ничего сборка_писать_кэш(символ* путь, целое64 значение)
внешняя целое32 сборка_собрать_зависимость(символ* каталог)
внешняя целое32 сборка_переименовать_срез(срез<символ> из, срез<символ> в)
внешняя целое32 сборка_файл_есть(символ* путь)
внешняя целое64 сборка_хеш_включений_с(символ* путь_источника, целое64 seed)
// Пул процессов для параллельной сборки (-j).
внешняя целое32 сборка_форкнуть()
внешняя ничего сборка_выход(целое32 код)
внешняя целое32 сборка_ждать_любого()
внешняя целое32 сборка_запустить_зависимость_нежд(символ* каталог, целое32 задания)
// это_число / первое_число / начинается_с / равенство строк — из stdlib
// (строки.конда, вкомпилена во фронтенд); шим C-версий больше не держит.
внешняя целое32 сборка_число_ядер()
внешняя целое32 сборка_взять_блокировку()
// Список источников: явный (из манифеста) либо авто-скан каталога на *.конда.
внешняя ничего сборка_источники_очистить()
внешняя ничего сборка_источник_добавить(символ* путь)
внешняя целое32 сборка_сканировать_исходники()
внешняя целое32 сборка_источник_исключить(символ* имя)
внешняя целое32 сборка_число_источников()
внешняя символ* сборка_источник(целое32 индекс)
внешняя символ* сборка_база_из_источника()

// Дописать все байты среза в растущий буфер команды.
ничего добавить_текст(изменяемый буфер<символ> команда, срез<символ> текст)
{
    целое32 количество = как<целое32>(длина(текст))
    для индекс в 0..количество {
        добавить(команда, текст[индекс])
    }
}


// §103 Версия проекта — СТРУКТУРА из трёх «неподписанный целое8» (мажор.минор.патч),
// то же типизированное представление, что и «КондаВерсия» в транспиляторе. Создаётся
// функцией из строки «X.Y.Z»: цифры копятся в текущее поле, точка/иной символ его
// завершают; каждое поле насыщается в диапазоне 0..255. Битый ввод → нули.
структура Версия { неподписанный целое8 мажор; неподписанный целое8 минор; неподписанный целое8 патч }

Версия версия_из_строки(срез<символ> текст)
{
    неподписанный целое8 части[3] = { 0, 0, 0 }
    целое32 номер = 0
    целое32 текущее = 0
    целое32 количество = как<целое32>(длина(текст))
    для индекс в 0..количество {
        символ с = текст[индекс]
        если с >= '0' и с <= '9' {
            текущее = текущее * 10 + (код(с) - код('0'))
            если текущее > 255 { текущее = 255 }
        } иначе если номер < 3 {
            части[номер] = как<неподписанный целое8>(текущее)
            номер = номер + 1
            текущее = 0
        }
    }
    если номер < 3 {
        части[номер] = как<неподписанный целое8>(текущее)
    }
    Версия версия = { мажор = части[0], минор = части[1], патч = части[2] }
    вернуть версия
}

// Булев флаг манифеста (прикладной сахар над TOML): да/true → истина,
// нет/false/отсутствие → по умолчанию. TOML-библиотека знает только true/false;
// синонимы да/нет — забота приложения, поэтому интерпретируем их тут.
логический флаг_манифеста(срез<символ> текст, срез<символ> секция, срез<символ> ключ, логический умолчание)
{
    Диапазон значение = томл_значение(текст, секция, ключ)
    если значение.есть == ложь { вернуть умолчание }
    если совпадает_в(текст, значение.начало, "да") или совпадает_в(текст, значение.начало, "true") { вернуть истина }
    если совпадает_в(текст, значение.начало, "нет") или совпадает_в(текст, значение.начало, "false") { вернуть ложь }
    вернуть умолчание
}

// Дописать в буфер NUL-терминированную C-строку (источник из шим-стора — базовое
// имя выхода). Чтение сырого символ* — под гейтом «небезопасно» (инвариант №2);
// строка своя (наш стор), NUL-терминирована по построению → безопасно.
ничего добавить_си(изменяемый буфер<символ> куда, символ* строка)
{
    небезопасно {
        целое32 индекс = 0
        пока строка[индекс] != '\0' {
            добавить(куда, строка[индекс])
            индекс = индекс + 1
        }
    }
}

// Наполнить стор источников и вернуть их число. Источники находятся ТОЛЬКО
// авто-сканом каталога проекта на *.конда (как в Cargo; поле «[проект].исходники»
// больше НЕ поддерживается), затем вычитаются имена из «[проект].исключить»
// (не-исходники: примеры со своей точкой входа и т.п.). Порядок — отсортированный
// (scandir+alphasort), детерминированный → стабильный ключ хеш-кэша.
целое32 подготовить_источники(срез<символ> текст)
{
    сборка_источники_очистить()
    сборка_сканировать_исходники()
    целое32 число_исключений = томл_длина_списка(текст, "проект", "исключить")
    для индекс в 0..число_исключений {
        Диапазон исключение = томл_элемент(текст, "проект", "исключить", индекс)
        если исключение.есть {
            сборка_источник_исключить(вкси(текст[исключение.начало : исключение.начало + исключение.длина]))
        }
    }
    вернуть сборка_число_источников()
}

// Дописать базовое имя выходных артефактов: «[проект].имя», если задано (для
// монолитной библиотеки из нескольких источников — единственный способ назвать
// .so/.и/.h), иначе базовое имя первого источника (из стора, наполненного
// подготовить_источники). Транспилятор именует выход тем же правилом: явный
// «--имя=<имя>» побеждает имя-от-первого-файла.
ничего добавить_базу_вывода(изменяемый буфер<символ> куда, срез<символ> текст)
{
    Диапазон имя = томл_строка(текст, "проект", "имя")
    если имя.есть {
        добавить_текст(куда, текст[имя.начало : имя.начало + имя.длина])
    } иначе {
        добавить_си(куда, сборка_база_из_источника())
    }
}

// Дописать в буфер ожидаемый путь первичного артефакта цели: <каталог>/<имя>,
// где имя = «выход» (программа) либо база_вывода + .elf/.so.
ничего добавить_путь_выхода(изменяемый буфер<символ> путь, срез<символ> текст, логический кросс, срез<символ> цель)
{
    добавить_текст(путь, "вывод")
    если кросс { добавить_текст(путь, "/"); добавить_текст(путь, цель) }
    добавить_текст(путь, "/")
    Диапазон тип = томл_строка(текст, "проект", "тип")
    логический это_библиотека = тип.есть и совпадает_в(текст, тип.начало, "библиотека")
    Диапазон выход = томл_строка(текст, "проект", "выход")
    если это_библиотека == ложь и выход.есть {
        добавить_текст(путь, текст[выход.начало : выход.начало + выход.длина])
    } иначе {
        добавить_базу_вывода(путь, текст)
        если это_библиотека { добавить_текст(путь, ".so") } иначе { добавить_текст(путь, ".elf") }
    }
}

// Дописать префикс каталога вывода: «вывод» (хост) или «вывод/<триплет>» (кросс).
ничего добавить_каталог_вывода(изменяемый буфер<символ> куда, логический кросс, срез<символ> цель)
{
    добавить_текст(куда, "вывод")
    если кросс {
        добавить_текст(куда, "/")
        добавить_текст(куда, цель)
    }
}

// Собрать одну цель: сформировать команду транспилятора, проверить хеш-кэш,
// при необходимости запустить и переименовать выход. Возврат — код транспилятора.
целое32 собрать_цель(срез<символ> текст, логический кросс, срез<символ> цель, логический пересобрать)
{
    // argv-хвост (без argv[0]/NULL — их добавит шим). Каждый элемент — отдельная
    // C-строка → execvp без shell: пробелы/спецсимволы в путях передаются дословно.
    буфер<символ*> аргв = выделить(0)
    срез<символ> пусто = ""

    // Тип: библиотека → --библиотека.
    Диапазон тип = томл_строка(текст, "проект", "тип")
    если тип.есть и совпадает_в(текст, тип.начало, "библиотека") {
        добавить(аргв, вкси("--библиотека"))
    }
    // Режим: релиз → --релиз (иначе отладочная сборка по умолчанию).
    Диапазон режим = томл_строка(текст, "сборка", "режим")
    если режим.есть и совпадает_в(текст, режим.начало, "релиз") {
        добавить(аргв, вкси("--релиз"))
    }
    // Статическая линковка.
    если флаг_манифеста(текст, "сборка", "статический", ложь) {
        добавить(аргв, вкси("--статический"))
    }
    // Стандартная библиотека (по умолчанию включена).
    если флаг_манифеста(текст, "сборка", "стдлиб", истина) == ложь {
        добавить(аргв, вкси("--без-стандартной-библиотеки"))
    }
    // Аллокатор.
    Диапазон аллокатор = томл_строка(текст, "сборка", "аллокатор")
    если аллокатор.есть {
        добавить(аргв, сборка_склеить("--аллокатор=", текст[аллокатор.начало : аллокатор.начало + аллокатор.длина]))
    }
    // Версия проекта → штамп в ELF (§89): [проект] версия = X.Y.Z (без кавычек, §103).
    // Значение разбирается в СТРУКТУРУ Версия и переформатируется обратно (строка →
    // структура → строка), после чего нормализованная «X.Y.Z» уходит транспилятору.
    Диапазон версия = томл_строка(текст, "проект", "версия")
    если версия.есть {
        Версия в = версия_из_строки(текст[версия.начало : версия.начало + версия.длина])
        добавить(аргв, сборка_склеить("--версия-проекта=", "\(как<целое32>(в.мажор)).\(как<целое32>(в.минор)).\(как<целое32>(в.патч))"))
    }
    // Имя проекта → --имя (базовое имя выходных артефактов). Для монолитной
    // библиотеки из нескольких источников это ЕДИНСТВЕННЫЙ способ задать имя
    // .so/.и/.h (иначе транспилятор назвал бы её по первому источнику).
    Диапазон имя_проекта = томл_строка(текст, "проект", "имя")
    если имя_проекта.есть {
        добавить(аргв, сборка_склеить("--имя=", текст[имя_проекта.начало : имя_проекта.начало + имя_проекта.длина]))
    }
    // Кросс-цель: --целевая-архитектура + отдельный каталог вывода вывод/<триплет>.
    если кросс {
        добавить(аргв, сборка_склеить("--целевая-архитектура=", цель))
        добавить(аргв, сборка_склеить("--вывод=вывод/", цель))
    } иначе {
        добавить(аргв, вкси("--вывод=вывод"))
    }
    // Дополнительные сырые флаги.
    целое32 число_флагов = томл_длина_списка(текст, "сборка", "флаги")
    для индекс в 0..число_флагов {
        Диапазон флаг = томл_элемент(текст, "сборка", "флаги", индекс)
        если флаг.есть {
            добавить(аргв, сборка_склеить(пусто, текст[флаг.начало : флаг.начало + флаг.длина]))
        }
    }
    // Источники: явный список манифеста ЛИБО авто-скан каталога (*.конда) минус
    // «исключить» — наполняется в стор, оттуда берём стабильные C-строки-пути.
    целое32 число_источников = подготовить_источники(текст)
    для индекс в 0..число_источников {
        добавить(аргв, сборка_источник(индекс))
    }

    // Ключ актуальности: argv (флаги+имена+цель) + содержимое манифеста +
    // содержимое каждого источника + локальные C-заголовки источников (#3) +
    // ключ-файл каждой зависимости (#1) + бинарь транспилятора.
    целое64 ключ = фнв1а_аргв_с(аргв, 0)
    ключ = фнв1а_с(текст, ключ)
    для индекс в 0..число_источников {
        символ* путь_ист = сборка_источник(индекс)
        ключ = сборка_хеш_файла_с(путь_ист, ключ)
        // #3: содержимое локальных «#содержит "..."» C-заголовков источника —
        // правка C-шима меняет ключ (аналог depfiles у make).
        ключ = сборка_хеш_включений_с(путь_ист, ключ)
    }
    // #1 транзитивная устарелость: подмешать .кэш каждой зависимости (это её
    // собственный хеш входов — зависимость собирается ПЕРЕД целью и обновляет свой
    // .кэш; сменилась зависимость → сменился её .кэш → сменился наш ключ).
    целое32 число_зависимостей_ключ = томл_длина_списка(текст, "сборка", "зависимости")
    для индекс в 0..число_зависимостей_ключ {
        Диапазон зависимость = томл_элемент(текст, "сборка", "зависимости", индекс)
        если зависимость.есть {
            буфер<символ> путь_деп_кэша = выделить(0)
            добавить_текст(путь_деп_кэша, текст[зависимость.начало : зависимость.начало + зависимость.длина])
            добавить_текст(путь_деп_кэша, "/.konda-сборка.кэш")
            ключ = сборка_хеш_файла_с(вкси(путь_деп_кэша), ключ)
        }
    }
    ключ = сборка_хеш_транспилятора_с(ключ)

    // Путь кэша — свой на каждую цель.
    буфер<символ> путь_кэша = выделить(0)
    добавить_текст(путь_кэша, ".konda-сборка")
    если кросс {
        добавить_текст(путь_кэша, "-")
        добавить_текст(путь_кэша, цель)
    }
    добавить_текст(путь_кэша, ".кэш")

    // Ожидаемый первичный артефакт — для проверки существования (#2).
    буфер<символ> путь_выхода = выделить(0)
    добавить_путь_выхода(путь_выхода, текст, кросс, цель)

    если пересобрать == ложь {
        целое64 прежний = сборка_читать_кэш(вкси(путь_кэша))
        // #2: пропускаем ТОЛЬКО если ключ совпал И выходной бинарь на месте
        // (удалили бинарь при совпавшем ключе → пересобрать).
        если прежний != 0 и прежний == ключ и сборка_файл_есть(вкси(путь_выхода)) == 1 {
            printf("konda build: [%.*s] актуально — пропуск\n",
                   как<целое32>(длина(цель)), вкси(цель))
            вернуть 0
        }
    }

    printf("konda build: [%.*s] сборка (%d источник(ов))…\n",
           как<целое32>(длина(цель)), вкси(цель), число_источников)
    целое32 код = сборка_запустить(аргв)
    если код != 0 {
        printf("konda build: [%.*s] транспилятор завершился с кодом %d\n",
               как<целое32>(длина(цель)), вкси(цель), код)
        вернуть код
    }
    сборка_писать_кэш(вкси(путь_кэша), ключ)

    // Поле «выход»: переименовать <каталог>/<база_вывода>.elf в <каталог>/<выход>.
    // Транспилятор именует выход по «--имя» (если задан) либо по первому источнику
    // — то же правило, что и база_вывода.
    Диапазон выход = томл_строка(текст, "проект", "выход")
    если выход.есть {
        буфер<символ> путь_из = выделить(0)
        добавить_каталог_вывода(путь_из, кросс, цель)
        добавить_текст(путь_из, "/")
        добавить_базу_вывода(путь_из, текст)
        добавить_текст(путь_из, ".elf")

        буфер<символ> путь_в = выделить(0)
        добавить_каталог_вывода(путь_в, кросс, цель)
        добавить_текст(путь_в, "/")
        добавить_текст(путь_в, текст[выход.начало : выход.начало + выход.длина])

        сборка_переименовать_срез(путь_из, путь_в)
    }
    вернуть 0
}

// Параллельная сборка зависимостей (пул процессов с троттлингом -j). Каждая
// зависимость — отдельный re-exec фронтенда в её каталоге; при неудаче fork
// падаем на синхронную сборку, чтобы зависимость не потерялась. Возврат — код
// последней неуспешной сборки (0 при успехе всех).
целое32 собрать_зависимости_параллельно(срез<символ> текст, целое32 задания)
{
    целое32 число = томл_длина_списка(текст, "сборка", "зависимости")
    целое32 итог = 0
    целое32 живых = 0
    для индекс в 0..число {
        Диапазон зависимость = томл_элемент(текст, "сборка", "зависимости", индекс)
        если зависимость.есть {
            пока живых >= задания {
                целое32 код = сборка_ждать_любого()
                если код != 0 { итог = код }
                живых = живых - 1
            }
            символ* каталог = вкси(текст[зависимость.начало : зависимость.начало + зависимость.длина])
            printf("konda build: зависимость %.*s…\n", зависимость.длина, каталог)
            целое32 пид = сборка_запустить_зависимость_нежд(каталог, задания)
            если пид > 0 {
                живых = живых + 1
            } иначе {
                целое32 код = сборка_собрать_зависимость(каталог)
                если код != 0 { итог = код }
            }
        }
    }
    пока живых > 0 {
        целое32 код = сборка_ждать_любого()
        если код != 0 { итог = код }
        живых = живых - 1
    }
    вернуть итог
}

// Параллельная сборка целей (пул процессов с троттлингом -j). Каждая цель —
// потомок, выполняющий собрать_цель и завершающийся сборка_выход (в цикл не
// возвращается). Цели пишут в РАЗНЫЕ вывод/<триплет> с раздельными кэшами →
// гонок по выходным файлам нет. Вызывается лишь когда целей > 0.
целое32 собрать_цели_параллельно(срез<символ> текст, логический пересобрать, целое32 задания)
{
    целое32 число_целей = томл_длина_списка(текст, "сборка", "цели")
    срез<символ> метка_хост = "хост"
    целое32 длина_метки_хост = как<целое32>(длина(метка_хост))
    целое32 итог = 0
    целое32 живых = 0
    для индекс в 0..число_целей {
        Диапазон цель = томл_элемент(текст, "сборка", "цели", индекс)
        если цель.есть {
            логический хост = совпадает_в(текст, цель.начало, "хост") и цель.длина == длина_метки_хост
            пока живых >= задания {
                целое32 код = сборка_ждать_любого()
                если код != 0 { итог = код }
                живых = живых - 1
            }
            целое32 пид = сборка_форкнуть()
            если пид == 0 {
                целое32 код_ц = собрать_цель(текст, хост == ложь, текст[цель.начало : цель.начало + цель.длина], пересобрать)
                сборка_выход(код_ц)
            } иначе если пид > 0 {
                живых = живых + 1
            } иначе {
                целое32 код = собрать_цель(текст, хост == ложь, текст[цель.начало : цель.начало + цель.длина], пересобрать)
                если код != 0 { итог = код }
            }
        }
    }
    пока живых > 0 {
        целое32 код = сборка_ждать_любого()
        если код != 0 { итог = код }
        живых = живых - 1
    }
    вернуть итог
}

целое32 точка_входа(срез<символ*> аргументы)
{
    // Разбор аргументов: последний не-флаг — путь манифеста (умолч. «Konda.toml»);
    // «--пересобрать» отключает пропуск по кэшу.
    // Параллелизм -j: «-jN»/«--задания=N»/«-j N» = N заданий; «-j»/«--задания»
    // без числа = число ядер (авто). По умолчанию 1 (последовательно — как было).
    символ* путь_манифеста = вкси("Konda.toml")
    логический пересобрать = ложь
    целое32 задания = 1
    логический следующее_число = ложь
    целое32 число_аргументов = как<целое32>(длина(аргументы))
    для индекс в 1..число_аргументов {
        символ* арг = аргументы[индекс]
        // Копируем C-строку argv в буфер → дальше используем срез-предикаты stdlib
        // (равенство «==» §100, начинается_с, это_число, первое_число) вместо
        // C-шимовых дублей. Буфер живёт только внутри итерации (автоосвобождение).
        буфер<символ> арг_срез = выделить(0)
        добавить_си(арг_срез, арг)
        логический обработан = ложь
        // Значение «-j», заданное отдельным аргументом, — только если это число
        // (иначе следующий аргумент — путь манифеста, а -j остаётся «авто»).
        если следующее_число {
            следующее_число = ложь
            если это_число(арг_срез) {
                задания = как<целое32>(первое_число(арг_срез))
                обработан = истина
            }
        }
        если обработан == ложь {
            если арг_срез == "--пересобрать" {
                пересобрать = истина
            } иначе если арг_срез == "-j" или арг_срез == "--задания" {
                задания = 0
                следующее_число = истина
            } иначе если начинается_с(арг_срез, "--задания=") {
                задания = как<целое32>(первое_число(арг_срез))
            } иначе если начинается_с(арг_срез, "-j") {
                задания = как<целое32>(первое_число(арг_срез))
            } иначе {
                путь_манифеста = арг
            }
        }
    }
    если задания <= 0 { задания = сборка_число_ядер() }

    // Межпроцессная блокировка каталога сборки: делает параллельную сборку
    // зависимостей корректной при ромбе (общая под-зависимость собирается из
    // двух мест — вторая ждёт и видит кэш актуальным). Держится до выхода.
    сборка_взять_блокировку()

    // Прочитать манифест в буфер (срез — чтобы брать подсрезы прочитанного).
    срез<символ> буфер_манифеста = выделить(65536)
    целое32 прочитано = сборка_прочитать_файл(путь_манифеста, буфер_манифеста)
    если прочитано < 0 {
        printf("konda build: не удалось прочитать манифест «%s»\n", путь_манифеста)
        вернуть 1
    }
    срез<символ> текст = буфер_манифеста[0 : прочитано]

    // Источники: авто-скан каталога на *.конда (как в Cargo; не-исходники убираются
    // полем «[проект].исключить»). Ошибка — только если источников нет вовсе.
    если подготовить_источники(текст) == 0 {
        printf("konda build: нет источников — в каталоге нет *.конда\n")
        вернуть 1
    }

    // Сначала собрать зависимости (каждая — свой Konda.toml и свой кэш).
    // Параллельно при -j>1 (пул процессов), иначе последовательно (как было).
    если задания > 1 {
        целое32 код_деп = собрать_зависимости_параллельно(текст, задания)
        если код_деп != 0 {
            printf("konda build: зависимость не собралась (код %d)\n", код_деп)
            вернуть код_деп
        }
    } иначе {
        целое32 число_зависимостей = томл_длина_списка(текст, "сборка", "зависимости")
        для индекс в 0..число_зависимостей {
            Диапазон зависимость = томл_элемент(текст, "сборка", "зависимости", индекс)
            если зависимость.есть {
                printf("konda build: зависимость %.*s…\n",
                       зависимость.длина, вкси(текст[зависимость.начало : зависимость.начало + зависимость.длина]))
                целое32 код = сборка_собрать_зависимость(вкси(текст[зависимость.начало : зависимость.начало + зависимость.длина]))
                если код != 0 {
                    printf("konda build: зависимость не собралась (код %d)\n", код)
                    вернуть код
                }
            }
        }
    }

    // Цели: массив триплетов «цели» ([сборка]); «хост» = нативная. Пусто → хост.
    // При нескольких целях и -j>1 — параллельный пул (цели независимы: каждая
    // пишет в свой вывод/<триплет>). Одна цель/хост — прямая сборка (параллелить
    // нечего). Иначе (-j1) — последовательно, как было.
    целое32 число_целей = томл_длина_списка(текст, "сборка", "цели")
    целое32 итог = 0
    если число_целей == 0 {
        итог = собрать_цель(текст, ложь, "хост", пересобрать)
    } иначе если задания > 1 {
        итог = собрать_цели_параллельно(текст, пересобрать, задания)
    } иначе {
        срез<символ> метка_хост = "хост"
        целое32 длина_метки_хост = как<целое32>(длина(метка_хост))
        для индекс в 0..число_целей {
            Диапазон цель = томл_элемент(текст, "сборка", "цели", индекс)
            если цель.есть {
                логический хост = совпадает_в(текст, цель.начало, "хост") и цель.длина == длина_метки_хост
                целое32 код = собрать_цель(текст, хост == ложь, текст[цель.начало : цель.начало + цель.длина], пересобрать)
                если код != 0 { итог = код }
            }
        }
    }

    если итог == 0 {
        printf("konda build: готово\n")
    }
    вернуть итог
}
