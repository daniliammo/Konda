// konda build — фронтенд системы сборки Konda (вариант B: отдельный Konda-бинарь).
// Читает манифест Konda.toml, разбирает его через libkonda_toml (через .и),
// собирает командную строку транспилятора и запускает его. Хеш-кэш защищает от
// устаревания (см. docs/СИСТЕМА_СБОРКИ.md). Кросс-платформенность — массив
// «цели» в [сборка]: по одной сборке на триплет, каждая в вывод/<триплет>.
//
// Имена — БЕЗ сокращений (правило проекта). Прикладная семантика манифеста
// (синонимы булевых да/нет, знание ключей) живёт ЗДЕСЬ, а не в TOML-библиотеке.

#содержит <stdio.h>
#содержит "../toml/вывод/toml.h"   // подтягивает toml.и (Диапазон, томл_*) + линкует toml.so
#содержит "сборка_шим.h"

внешняя целое32 сборка_прочитать_файл(символ* путь, срез<символ> буфер)
внешняя целое32 сборка_запустить(срез<символ> хвост)
внешняя целое64 сборка_хеш_среза_с(срез<символ> данные, целое64 seed)
внешняя целое64 сборка_хеш_файла_с(символ* путь, целое64 seed)
внешняя целое64 сборка_хеш_транспилятора_с(целое64 seed)
внешняя целое64 сборка_читать_кэш(символ* путь)
внешняя ничего сборка_писать_кэш(символ* путь, целое64 значение)
внешняя целое32 сборка_равно_си(символ* левый, символ* правый)
внешняя целое32 сборка_собрать_зависимость(символ* каталог)
внешняя целое32 сборка_переименовать_срез(срез<символ> из, срез<символ> в)

// Дописать все байты среза в растущий буфер команды.
ничего добавить_текст(изменяемый буфер<символ> команда, срез<символ> текст)
{
    целое32 количество = как<целое32>(длина(текст))
    для индекс в 0..количество {
        добавить(команда, текст[индекс])
    }
}


// Булев флаг манифеста (прикладной сахар над TOML): да/true → истина,
// нет/false/отсутствие → по умолчанию. TOML-библиотека знает только true/false;
// синонимы да/нет — забота приложения, поэтому интерпретируем их тут.
логический флаг_манифеста(срез<символ> текст, срез<символ> секция, срез<символ> ключ, логический умолчание)
{
    Диапазон значение = томл_значение(текст, секция, ключ)
    если значение.есть == ложь { вернуть умолчание }
    если совпадает_в(текст, значение.начало, "да") или совпадает_в(текст, значение.начало, "true") { вернуть истина }
    если совпадает_в(текст, значение.начало, "нет") или совпадает_в(текст, значение.начало, "false") { вернуть ложь }
    вернуть умолчание
}

// Дописать префикс каталога вывода: «вывод» (хост) или «вывод/<триплет>» (кросс).
ничего добавить_каталог_вывода(изменяемый буфер<символ> куда, логический кросс, срез<символ> цель)
{
    добавить_текст(куда, "вывод")
    если кросс {
        добавить_текст(куда, "/")
        добавить_текст(куда, цель)
    }
}

// Собрать одну цель: сформировать команду транспилятора, проверить хеш-кэш,
// при необходимости запустить и переименовать выход. Возврат — код транспилятора.
целое32 собрать_цель(срез<символ> текст, логический кросс, срез<символ> цель, логический пересобрать)
{
    буфер<символ> команда = выделить(0)

    // Тип: библиотека → --библиотека.
    Диапазон тип = томл_строка(текст, "проект", "тип")
    если тип.есть и совпадает_в(текст, тип.начало, "библиотека") {
        добавить_текст(команда, " --библиотека")
    }
    // Режим: релиз → --релиз (иначе отладочная сборка по умолчанию).
    Диапазон режим = томл_строка(текст, "сборка", "режим")
    если режим.есть и совпадает_в(текст, режим.начало, "релиз") {
        добавить_текст(команда, " --релиз")
    }
    // Статическая линковка.
    если флаг_манифеста(текст, "сборка", "статический", ложь) {
        добавить_текст(команда, " --статический")
    }
    // Стандартная библиотека (по умолчанию включена).
    если флаг_манифеста(текст, "сборка", "стдлиб", истина) == ложь {
        добавить_текст(команда, " --без-стандартной-библиотеки")
    }
    // Аллокатор.
    Диапазон аллокатор = томл_строка(текст, "сборка", "аллокатор")
    если аллокатор.есть {
        добавить_текст(команда, " --аллокатор=")
        добавить_текст(команда, текст[аллокатор.начало : аллокатор.начало + аллокатор.длина])
    }
    // Кросс-цель: --целевая-архитектура + отдельный каталог вывода.
    если кросс {
        добавить_текст(команда, " --целевая-архитектура=")
        добавить_текст(команда, цель)
    }
    добавить_текст(команда, " --вывод=")
    добавить_каталог_вывода(команда, кросс, цель)
    // Дополнительные сырые флаги.
    целое32 число_флагов = томл_длина_списка(текст, "сборка", "флаги")
    для индекс в 0..число_флагов {
        Диапазон флаг = томл_элемент(текст, "сборка", "флаги", индекс)
        если флаг.есть {
            добавить_текст(команда, " ")
            добавить_текст(команда, текст[флаг.начало : флаг.начало + флаг.длина])
        }
    }
    // Источники.
    целое32 число_источников = томл_длина_списка(текст, "проект", "исходники")
    для индекс в 0..число_источников {
        Диапазон источник = томл_элемент(текст, "проект", "исходники", индекс)
        если источник.есть {
            добавить_текст(команда, " ")
            добавить_текст(команда, текст[источник.начало : источник.начало + источник.длина])
        }
    }

    // Ключ актуальности: команда (флаги+имена+цель) + содержимое манифеста +
    // содержимое каждого источника + бинарь транспилятора.
    целое64 ключ = сборка_хеш_среза_с(команда, 0)
    ключ = сборка_хеш_среза_с(текст, ключ)
    для индекс в 0..число_источников {
        Диапазон источник = томл_элемент(текст, "проект", "исходники", индекс)
        если источник.есть {
            ключ = сборка_хеш_файла_с(вкси(текст[источник.начало : источник.начало + источник.длина]), ключ)
        }
    }
    ключ = сборка_хеш_транспилятора_с(ключ)

    // Путь кэша — свой на каждую цель.
    буфер<символ> путь_кэша = выделить(0)
    добавить_текст(путь_кэша, ".konda-сборка")
    если кросс {
        добавить_текст(путь_кэша, "-")
        добавить_текст(путь_кэша, цель)
    }
    добавить_текст(путь_кэша, ".кэш")

    если пересобрать == ложь {
        целое64 прежний = сборка_читать_кэш(вкси(путь_кэша))
        если прежний != 0 и прежний == ключ {
            printf("konda build: [%.*s] актуально — пропуск\n",
                   как<целое32>(длина(цель)), вкси(цель))
            вернуть 0
        }
    }

    printf("konda build: [%.*s] сборка (%d источник(ов))…\n",
           как<целое32>(длина(цель)), вкси(цель), число_источников)
    целое32 код = сборка_запустить(команда)
    если код != 0 {
        printf("konda build: [%.*s] транспилятор завершился с кодом %d\n",
               как<целое32>(длина(цель)), вкси(цель), код)
        вернуть код
    }
    сборка_писать_кэш(вкси(путь_кэша), ключ)

    // Поле «выход»: переименовать <каталог>/<базовое имя первого источника>.elf
    // в <каталог>/<выход>. Транспилятор именует выход по первому источнику.
    Диапазон выход = томл_строка(текст, "проект", "выход")
    если выход.есть {
        Диапазон первый = томл_элемент(текст, "проект", "исходники", 0)
        если первый.есть {
            целое32 конец_первого = первый.начало + первый.длина
            целое32 начало_имени = первый.начало
            для позиция в первый.начало..конец_первого {
                если текст[позиция] == '/' { начало_имени = позиция + 1 }
            }
            целое32 конец_имени = конец_первого
            для позиция в начало_имени..конец_первого {
                если текст[позиция] == '.' { конец_имени = позиция }
            }
            срез<символ> базовое = текст[начало_имени : конец_имени]

            буфер<символ> путь_из = выделить(0)
            добавить_каталог_вывода(путь_из, кросс, цель)
            добавить_текст(путь_из, "/")
            добавить_текст(путь_из, базовое)
            добавить_текст(путь_из, ".elf")

            буфер<символ> путь_в = выделить(0)
            добавить_каталог_вывода(путь_в, кросс, цель)
            добавить_текст(путь_в, "/")
            добавить_текст(путь_в, текст[выход.начало : выход.начало + выход.длина])

            сборка_переименовать_срез(путь_из, путь_в)
        }
    }
    вернуть 0
}

целое32 точка_входа(срез<символ*> аргументы)
{
    // Разбор аргументов: последний не-флаг — путь манифеста (умолч. «Konda.toml»);
    // «--пересобрать» отключает пропуск по кэшу.
    символ* путь_манифеста = вкси("Konda.toml")
    логический пересобрать = ложь
    целое32 число_аргументов = как<целое32>(длина(аргументы))
    для индекс в 1..число_аргументов {
        если сборка_равно_си(аргументы[индекс], вкси("--пересобрать")) == 1 {
            пересобрать = истина
        } иначе {
            путь_манифеста = аргументы[индекс]
        }
    }

    // Прочитать манифест в буфер (срез — чтобы брать подсрезы прочитанного).
    срез<символ> буфер_манифеста = выделить(65536)
    целое32 прочитано = сборка_прочитать_файл(путь_манифеста, буфер_манифеста)
    если прочитано < 0 {
        printf("konda build: не удалось прочитать манифест «%s»\n", путь_манифеста)
        вернуть 1
    }
    срез<символ> текст = буфер_манифеста[0 : прочитано]

    // Обязательно: список источников.
    если томл_длина_списка(текст, "проект", "исходники") == 0 {
        printf("konda build: в [проект] нет непустого массива «исходники»\n")
        вернуть 1
    }

    // Сначала собрать зависимости (каждая — свой Konda.toml и свой кэш).
    целое32 число_зависимостей = томл_длина_списка(текст, "сборка", "зависимости")
    для индекс в 0..число_зависимостей {
        Диапазон зависимость = томл_элемент(текст, "сборка", "зависимости", индекс)
        если зависимость.есть {
            printf("konda build: зависимость %.*s…\n",
                   зависимость.длина, вкси(текст[зависимость.начало : зависимость.начало + зависимость.длина]))
            целое32 код = сборка_собрать_зависимость(вкси(текст[зависимость.начало : зависимость.начало + зависимость.длина]))
            если код != 0 {
                printf("konda build: зависимость не собралась (код %d)\n", код)
                вернуть код
            }
        }
    }

    // Цели: массив триплетов «цели» ([сборка]); «хост» = нативная. Пусто → хост.
    целое32 число_целей = томл_длина_списка(текст, "сборка", "цели")
    целое32 итог = 0
    если число_целей == 0 {
        итог = собрать_цель(текст, ложь, "хост", пересобрать)
    } иначе {
        срез<символ> метка_хост = "хост"
        целое32 длина_метки_хост = как<целое32>(длина(метка_хост))
        для индекс в 0..число_целей {
            Диапазон цель = томл_элемент(текст, "сборка", "цели", индекс)
            если цель.есть {
                логический хост = совпадает_в(текст, цель.начало, "хост") и цель.длина == длина_метки_хост
                целое32 код = собрать_цель(текст, хост == ложь, текст[цель.начало : цель.начало + цель.длина], пересобрать)
                если код != 0 { итог = код }
            }
        }
    }

    если итог == 0 {
        printf("konda build: готово\n")
    }
    вернуть итог
}
