// libkonda_toml — подмножество TOML для манифестов сборки Konda.
// Query-based, offsets-API: функции возвращают Диапазон (POD) — смещения в
// исходном тексте, а срез строит вызывающий («текст[д.начало : д.начало+д.длина]»).
// Так обходится запрет возврата borrow-параметра (§37 п.6) и не нужны
// динамические контейнеры (буфер<структура>/срез<структура> с borrow-полями).
// Поддержано v1: секции [имя], пары «ключ = значение», комментарии «#»-строки,
// строки "…", целые, булевы true/false и да/нет, массивы строк ["a","b"].

структура Диапазон { целое32 начало; целое32 длина; логический есть }

// Совпадает ли «образец» в «т», начиная с позиции «поз» (побайтно).
логический _совпадает(срез<символ> т, целое32 поз, срез<символ> образец)
{
    целое32 н = как<целое32>(длина(т))
    целое32 м = как<целое32>(длина(образец))
    если поз + м > н { вернуть ложь }
    для i в 0..м {
        если т[поз + i] != образец[i] { вернуть ложь }
    }
    вернуть истина
}

// «поз» — начало строки (0 или после '\n')?
логический _начало_строки(срез<символ> т, целое32 поз)
{
    если поз == 0 { вернуть истина }
    вернуть т[поз - 1] == '\n'
}

// Тело секции «секц» как диапазон [начало, начало+длина). Пустая секц → верхний
// уровень (от начала текста до первого заголовка секции). Не найдено → есть=ложь.
Диапазон _тело_секции(срез<символ> т, срез<символ> секц)
{
    целое32 н = как<целое32>(длина(т))
    Диапазон итог = { начало = 0, длина = 0, есть = ложь }
    целое32 тело_нач = -1
    если как<целое32>(длина(секц)) == 0 {
        тело_нач = 0
    } иначе {
        // Ищем строку-заголовок «[секц]».
        для i в 0..н {
            если т[i] == '[' и _начало_строки(т, i) и _совпадает(т, i + 1, секц) и т[i + 1 + как<целое32>(длина(секц))] == ']' {
                // тело начинается после конца этой строки
                целое32 п = i
                пока п < н и т[п] != '\n' { п = п + 1 }
                если п < н { п = п + 1 }
                тело_нач = п
                прервать
            }
        }
    }
    если тело_нач < 0 { вернуть итог }
    // Конец тела — следующий заголовок секции (строка, начинающаяся с '[') или конец.
    целое32 к = тело_нач
    пока к < н {
        если т[к] == '[' и _начало_строки(т, к) { прервать }
        к = к + 1
    }
    итог.начало = тело_нач
    итог.длина = к - тело_нач
    итог.есть = истина
    вернуть итог
}

// Пропустить пробелы/табы, начиная с «поз», не выходя за «предел».
целое32 _проп_пробелы(срез<символ> т, целое32 поз, целое32 предел)
{
    пока поз < предел и (т[поз] == ' ' или т[поз] == '\t') { поз = поз + 1 }
    вернуть поз
}

// Сырое значение ключа [секц].ключ: диапазон от первого не-пробела после '=' до
// конца строки (с обрезанными хвостовыми пробелами). Не найдено → есть=ложь.
Диапазон томл_значение(срез<символ> т, срез<символ> секц, срез<символ> ключ)
{
    Диапазон итог = { начало = 0, длина = 0, есть = ложь }
    Диапазон тело = _тело_секции(т, секц)
    если тело.есть == ложь { вернуть итог }
    целое32 нач = тело.начало
    целое32 кон = тело.начало + тело.длина
    целое32 кл = как<целое32>(длина(ключ))
    целое32 п = нач
    пока п < кон {
        // начало строки: пропустить ведущие пробелы
        целое32 сл = _проп_пробелы(т, п, кон)
        если сл < кон и т[сл] == '#' {
            // строка-комментарий — до конца строки
        } иначе если _совпадает(т, сл, ключ) {
            целое32 после = сл + кл
            целое32 хв = _проп_пробелы(т, после, кон)
            если хв < кон и т[хв] == '=' {
                целое32 в = _проп_пробелы(т, хв + 1, кон)
                целое32 е = в
                пока е < кон и т[е] != '\n' { е = е + 1 }
                // обрезать хвостовые пробелы
                пока е > в и (т[е - 1] == ' ' или т[е - 1] == '\t' или т[е - 1] == '\r') { е = е - 1 }
                итог.начало = в
                итог.длина = е - в
                итог.есть = истина
                вернуть итог
            }
        }
        // перейти на следующую строку
        пока п < кон и т[п] != '\n' { п = п + 1 }
        если п < кон { п = п + 1 }
    }
    вернуть итог
}

// Значение-строка без кавычек. Если значение не в кавычках — вернуть как есть.
Диапазон томл_строка(срез<символ> т, срез<символ> секц, срез<символ> ключ)
{
    Диапазон з = томл_значение(т, секц, ключ)
    если з.есть и з.длина >= 2 и т[з.начало] == '"' и т[з.начало + з.длина - 1] == '"' {
        з.начало = з.начало + 1
        з.длина = з.длина - 2
    }
    вернуть з
}

// Булев флаг: true/да → 1, false/нет → 0, иначе умолч.
целое32 томл_флаг(срез<символ> т, срез<символ> секц, срез<символ> ключ, целое32 умолч)
{
    Диапазон з = томл_значение(т, секц, ключ)
    если з.есть == ложь { вернуть умолч }
    если _совпадает(т, з.начало, "true") или _совпадает(т, з.начало, "да") { вернуть 1 }
    если _совпадает(т, з.начало, "false") или _совпадает(т, з.начало, "нет") { вернуть 0 }
    вернуть умолч
}

// Число элементов массива строк ["a","b",…]. Не массив → 0.
целое32 томл_длина_списка(срез<символ> т, срез<символ> секц, срез<символ> ключ)
{
    Диапазон з = томл_значение(т, секц, ключ)
    если з.есть == ложь или з.длина == 0 или т[з.начало] != '[' { вернуть 0 }
    целое32 и = з.начало + 1
    целое32 кон = з.начало + з.длина
    целое32 счёт = 0
    пока и < кон и т[и] != ']' {
        если т[и] == '"' {
            счёт = счёт + 1
            и = и + 1
            пока и < кон и т[и] != '"' { и = и + 1 }
        }
        и = и + 1
    }
    вернуть счёт
}

// i-й элемент массива строк (без кавычек). Нет → есть=ложь.
Диапазон томл_элемент(срез<символ> т, срез<символ> секц, срез<символ> ключ, целое32 индекс)
{
    Диапазон итог = { начало = 0, длина = 0, есть = ложь }
    Диапазон з = томл_значение(т, секц, ключ)
    если з.есть == ложь или з.длина == 0 или т[з.начало] != '[' { вернуть итог }
    целое32 и = з.начало + 1
    целое32 кон = з.начало + з.длина
    целое32 текущий = 0
    пока и < кон и т[и] != ']' {
        если т[и] == '"' {
            целое32 нач = и + 1
            и = и + 1
            пока и < кон и т[и] != '"' { и = и + 1 }
            если текущий == индекс {
                итог.начало = нач
                итог.длина = и - нач
                итог.есть = истина
                вернуть итог
            }
            текущий = текущий + 1
        }
        и = и + 1
    }
    вернуть итог
}
