// libkonda_toml — ЗАГОТОВКА TOML-библиотеки на Konda (подмножество).
// Цель: покрыть манифесты сборки Konda сейчас и служить основой для будущей
// ПОЛНОЙ, spec-faithful TOML-библиотеки. Поэтому здесь — только чистый разбор
// TOML: никакой прикладной семантики (синонимы булевых, знание о ключах
// манифеста и т.п. живут в приложении — во фронтенде сборки, не тут).
//
// Query-based, offsets-API: функции возвращают Диапазон (POD) — смещения в
// исходном тексте, а срез строит вызывающий («текст[диапазон.начало :
// диапазон.начало + диапазон.длина]»). Так обходится запрет возврата
// borrow-параметра (§37 п.6) и не нужны динамические контейнеры
// (буфер<структура>/срез<структура> с borrow-полями). Полная библиотека позже
// сможет разбирать в дерево — API останется совместимым надстройкой.
//
// Стиль: имена функций и переменных — БЕЗ сокращений (полные слова).
//
// Поддержано: секции [имя], пары «ключ = значение», комментарии «#» (целой
// строкой и в конце строки-значения), строки "…", булевы true/false, массивы
// строк ["a", "b"] (в т.ч. многострочные). Не поддержано (позже, в полной
// версии): целые/дробные, вложенные/точечные ключи, inline-таблицы,
// arrays-of-tables, литеральные/многострочные строки, escape внутри строк, даты.

структура Диапазон { целое32 начало; целое32 длина; логический есть }

// Совпадает ли «образец» в «текст», начиная с позиции (побайтно)?
логический совпадает_в(срез<символ> текст, целое32 позиция, срез<символ> образец)
{
    целое32 длина_текста = как<целое32>(длина(текст))
    целое32 длина_образца = как<целое32>(длина(образец))
    если позиция + длина_образца > длина_текста { вернуть ложь }
    для смещение в 0..длина_образца {
        если текст[позиция + смещение] != образец[смещение] { вернуть ложь }
    }
    вернуть истина
}

// Позиция — начало строки (0 или сразу после '\n')?
логический начало_строки(срез<символ> текст, целое32 позиция)
{
    если позиция == 0 { вернуть истина }
    вернуть текст[позиция - 1] == '\n'
}

// Тело секции как диапазон. Пустая секция → верхний уровень (от начала текста
// до первого заголовка секции). Не найдено → есть=ложь.
Диапазон тело_секции(срез<символ> текст, срез<символ> секция)
{
    целое32 длина_текста = как<целое32>(длина(текст))
    Диапазон итог = { начало = 0, длина = 0, есть = ложь }
    целое32 начало_тела = -1
    если как<целое32>(длина(секция)) == 0 {
        начало_тела = 0
    } иначе {
        для позиция в 0..длина_текста {
            если текст[позиция] == '[' и начало_строки(текст, позиция) и совпадает_в(текст, позиция + 1, секция) и текст[позиция + 1 + как<целое32>(длина(секция))] == ']' {
                целое32 курсор = позиция
                пока курсор < длина_текста и текст[курсор] != '\n' { курсор = курсор + 1 }
                если курсор < длина_текста { курсор = курсор + 1 }
                начало_тела = курсор
                прервать
            }
        }
    }
    если начало_тела < 0 { вернуть итог }
    // Конец тела — следующий заголовок секции (строка с '[') или конец текста.
    целое32 конец_тела = начало_тела
    пока конец_тела < длина_текста {
        если текст[конец_тела] == '[' и начало_строки(текст, конец_тела) { прервать }
        конец_тела = конец_тела + 1
    }
    итог.начало = начало_тела
    итог.длина = конец_тела - начало_тела
    итог.есть = истина
    вернуть итог
}

// Пропустить пробелы и табы, начиная с позиции, не выходя за предел.
целое32 пропустить_пробелы(срез<символ> текст, целое32 позиция, целое32 предел)
{
    пока позиция < предел и (текст[позиция] == ' ' или текст[позиция] == '\t') { позиция = позиция + 1 }
    вернуть позиция
}

// Сырое значение ключа [секция].ключ. Скаляр — до конца строки или до
// внекавычечного '#' (inline-комментарий), с обрезанными хвостовыми пробелами.
// Массив — от '[' до парной ']' (может занимать несколько строк). Нет → есть=ложь.
Диапазон томл_значение(срез<символ> текст, срез<символ> секция, срез<символ> ключ)
{
    Диапазон итог = { начало = 0, длина = 0, есть = ложь }
    Диапазон тело = тело_секции(текст, секция)
    если тело.есть == ложь { вернуть итог }
    целое32 начало_тела = тело.начало
    целое32 конец_тела = тело.начало + тело.длина
    целое32 длина_ключа = как<целое32>(длина(ключ))
    целое32 позиция = начало_тела
    пока позиция < конец_тела {
        целое32 начало_содержимого = пропустить_пробелы(текст, позиция, конец_тела)
        если начало_содержимого < конец_тела и текст[начало_содержимого] == '#' {
            // строка-комментарий — пропустить
        } иначе если совпадает_в(текст, начало_содержимого, ключ) {
            целое32 после_ключа = пропустить_пробелы(текст, начало_содержимого + длина_ключа, конец_тела)
            если после_ключа < конец_тела и текст[после_ключа] == '=' {
                целое32 значение_начало = пропустить_пробелы(текст, после_ключа + 1, конец_тела)
                целое32 значение_конец = значение_начало
                логический в_кавычках = ложь
                если значение_начало < конец_тела и текст[значение_начало] == '[' {
                    // массив — до парной закрывающей скобки
                    пока значение_конец < конец_тела {
                        символ текущий = текст[значение_конец]
                        если текущий == '"' {
                            если в_кавычках { в_кавычках = ложь } иначе { в_кавычках = истина }
                        }
                        значение_конец = значение_конец + 1
                        если текущий == ']' и в_кавычках == ложь { прервать }
                    }
                } иначе {
                    // скаляр — до конца строки или внекавычечного '#'
                    пока значение_конец < конец_тела {
                        символ текущий = текст[значение_конец]
                        если текущий == '\n' { прервать }
                        если текущий == '"' {
                            если в_кавычках { в_кавычках = ложь } иначе { в_кавычках = истина }
                        }
                        если текущий == '#' и в_кавычках == ложь { прервать }
                        значение_конец = значение_конец + 1
                    }
                    пока значение_конец > значение_начало и (текст[значение_конец - 1] == ' ' или текст[значение_конец - 1] == '\t' или текст[значение_конец - 1] == '\r') { значение_конец = значение_конец - 1 }
                }
                итог.начало = значение_начало
                итог.длина = значение_конец - значение_начало
                итог.есть = истина
                вернуть итог
            }
        }
        пока позиция < конец_тела и текст[позиция] != '\n' { позиция = позиция + 1 }
        если позиция < конец_тела { позиция = позиция + 1 }
    }
    вернуть итог
}

// Значение-строка без кавычек. Не в кавычках — вернуть как есть.
Диапазон томл_строка(срез<символ> текст, срез<символ> секция, срез<символ> ключ)
{
    Диапазон значение = томл_значение(текст, секция, ключ)
    если значение.есть и значение.длина >= 2 и текст[значение.начало] == '"' и текст[значение.начало + значение.длина - 1] == '"' {
        значение.начало = значение.начало + 1
        значение.длина = значение.длина - 2
    }
    вернуть значение
}

// Булев флаг по спецификации TOML: true → 1, false → 0, иначе умолчание.
// (Только «true»/«false» — TOML других написаний булевых не знает. Прикладные
// синонимы вроде «да»/«нет» — забота приложения, не этой библиотеки.)
целое32 томл_флаг(срез<символ> текст, срез<символ> секция, срез<символ> ключ, целое32 умолчание)
{
    Диапазон значение = томл_значение(текст, секция, ключ)
    если значение.есть == ложь { вернуть умолчание }
    если совпадает_в(текст, значение.начало, "true") { вернуть 1 }
    если совпадает_в(текст, значение.начало, "false") { вернуть 0 }
    вернуть умолчание
}

// Число элементов массива строк ["a","b",…]. Не массив → 0.
целое32 томл_длина_списка(срез<символ> текст, срез<символ> секция, срез<символ> ключ)
{
    Диапазон значение = томл_значение(текст, секция, ключ)
    если значение.есть == ложь или значение.длина == 0 или текст[значение.начало] != '[' { вернуть 0 }
    целое32 позиция = значение.начало + 1
    целое32 конец = значение.начало + значение.длина
    целое32 количество = 0
    пока позиция < конец и текст[позиция] != ']' {
        если текст[позиция] == '"' {
            количество = количество + 1
            позиция = позиция + 1
            пока позиция < конец и текст[позиция] != '"' { позиция = позиция + 1 }
        }
        позиция = позиция + 1
    }
    вернуть количество
}

// Элемент массива строк по индексу (без кавычек). Нет → есть=ложь.
Диапазон томл_элемент(срез<символ> текст, срез<символ> секция, срез<символ> ключ, целое32 индекс)
{
    Диапазон итог = { начало = 0, длина = 0, есть = ложь }
    Диапазон значение = томл_значение(текст, секция, ключ)
    если значение.есть == ложь или значение.длина == 0 или текст[значение.начало] != '[' { вернуть итог }
    целое32 позиция = значение.начало + 1
    целое32 конец = значение.начало + значение.длина
    целое32 текущий_индекс = 0
    пока позиция < конец и текст[позиция] != ']' {
        если текст[позиция] == '"' {
            целое32 начало_элемента = позиция + 1
            позиция = позиция + 1
            пока позиция < конец и текст[позиция] != '"' { позиция = позиция + 1 }
            если текущий_индекс == индекс {
                итог.начало = начало_элемента
                итог.длина = позиция - начало_элемента
                итог.есть = истина
                вернуть итог
            }
            текущий_индекс = текущий_индекс + 1
        }
        позиция = позиция + 1
    }
    вернуть итог
}
