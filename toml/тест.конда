// Самотест libkonda_toml. Собирать вместе с toml.конда (мультифайл).
#содержит <stdio.h>

// Печать значения-строки по offsets.
ничего печать_значения(срез<символ> текст, срез<символ> метка, Диапазон диапазон)
{
    если диапазон.есть {
        срез<символ> значение = текст[диапазон.начало : диапазон.начало + диапазон.длина]
        printf("%.*s=[%.*s]\n", как<целое32>(длина(метка)), вкси(метка),
               как<целое32>(длина(значение)), вкси(значение))
    } иначе {
        printf("%.*s=<нет>\n", как<целое32>(длина(метка)), вкси(метка))
    }
}

// Печать булева флага словами «да»/«нет».
ничего печать_флага(срез<символ> метка, целое32 значение)
{
    если значение == 1 {
        printf("%.*s=да\n", как<целое32>(длина(метка)), вкси(метка))
    } иначе {
        printf("%.*s=нет\n", как<целое32>(длина(метка)), вкси(метка))
    }
}

целое32 точка_входа(срез<символ*> аргументы)
{
    // Многострочный массив «исходники» и inline-комментарий у «режим» —
    // проверяем, что и они разбираются.
    срез<символ> манифест = "# манифест\n[проект]\nимя = \"конда_init\"\nверсия = \"0.1.0\"\nисходники = [\n  \"основа.конда\",\n  \"утилиты.конда\",\n]\n\n[сборка]\nрежим = \"релиз\"   # рабочий режим\nстатический = true\nстдлиб = false\n"

    печать_значения(манифест, "имя", томл_строка(манифест, "проект", "имя"))
    печать_значения(манифест, "версия", томл_строка(манифест, "проект", "версия"))
    печать_значения(манифест, "режим", томл_строка(манифест, "сборка", "режим"))
    печать_флага("статический", томл_флаг(манифест, "сборка", "статический", 0))
    печать_флага("стдлиб", томл_флаг(манифест, "сборка", "стдлиб", 0))
    печать_флага("отладка(умолч)", томл_флаг(манифест, "сборка", "отладка", 0))
    printf("исходников=%d\n", томл_длина_списка(манифест, "проект", "исходники"))
    печать_значения(манифест, "ист0", томл_элемент(манифест, "проект", "исходники", 0))
    печать_значения(манифест, "ист1", томл_элемент(манифест, "проект", "исходники", 1))
    печать_значения(манифест, "нетключа", томл_строка(манифест, "проект", "нетключа"))
    вернуть 0
}
