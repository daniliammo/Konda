// Самотест libkonda_toml. Собирать вместе с toml.конда (мультифайл).
#содержит <stdio.h>

// Печать значения-строки по offsets.
ничего печ(срез<символ> т, срез<символ> метка, Диапазон д)
{
    если д.есть {
        срез<символ> в = т[д.начало : д.начало + д.длина]
        printf("%.*s=[%.*s]\n", как<целое32>(длина(метка)), вкси(метка),
               как<целое32>(длина(в)), вкси(в))
    } иначе {
        printf("%.*s=<нет>\n", как<целое32>(длина(метка)), вкси(метка))
    }
}

целое32 точка_входа(срез<символ*> аргументы)
{
    срез<символ> м = "# манифест\n[проект]\nимя = \"конда_init\"\nверсия = \"0.1.0\"\nисходники = [\"основа.конда\", \"утилиты.конда\"]\n\n[сборка]\nрежим = \"релиз\"\nстатический = true\nстдлиб = да\n"

    печ(м, "имя", томл_строка(м, "проект", "имя"))
    печ(м, "версия", томл_строка(м, "проект", "версия"))
    печ(м, "режим", томл_строка(м, "сборка", "режим"))
    printf("статический=%d\n", томл_флаг(м, "сборка", "статический", 0))
    printf("стдлиб=%d\n", томл_флаг(м, "сборка", "стдлиб", 0))
    printf("отладка(умолч)=%d\n", томл_флаг(м, "сборка", "отладка", 0))
    printf("исходников=%d\n", томл_длина_списка(м, "проект", "исходники"))
    печ(м, "ист0", томл_элемент(м, "проект", "исходники", 0))
    печ(м, "ист1", томл_элемент(м, "проект", "исходники", 1))
    печ(м, "нетключа", томл_строка(м, "проект", "нетключа"))
    вернуть 0
}
